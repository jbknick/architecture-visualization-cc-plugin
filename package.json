{
  "name": "gantry-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "10.31.0"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "action:e2e": "tsx scripts/action-e2e.ts",
    "build": "tsc -b && tsup && pnpm --filter @gantry/explorer build:web",
    "check": "biome check . && tsx scripts/check-toolchain.ts && tsx scripts/check-version.ts && tsc -b && tsc -p evals/tsconfig.json && vitest run && tsx scripts/describe-mutations.ts",
    "eval:clone": "tsx scripts/eval-clone.ts",
    "eval:packs": "tsx scripts/eval-packs.ts",
    "fmt": "biome check --write .",
    "protocol:examples": "tsx scripts/protocol-examples.ts",
    "perf": "GANTRY_PERF=1 vitest run -t performance packages/core/src/dup/engine.test.ts",
    "reattach:e2e": "tsx scripts/reattach-e2e.ts",
    "readme:media": "tsx scripts/readme-media.ts",
    "release": "tsx scripts/release.ts",
    "release:pack": "tsx scripts/pack.ts",
    "test": "vitest run",
    "version:check": "tsx scripts/check-version.ts"
  },
  "dependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.51.3",
    "better-sqlite3": "^13.1.1",
    "oxc-parser": "0.158.0",
    "oxc-resolver": "11.24.2",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@ast-grep/lang-csharp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.51.3",
    "@biomejs/biome": "^2.6.7",
    "@huggingface/transformers": "4.3.2",
    "@types/node": "^26.6.6",
    "better-sqlite3": "13.1.1",
    "gifenc": "1.0.3",
    "oxc-parser": "^0.158.0",
    "oxc-resolver": "11.24.2",
    "sqlite-vec": "0.1.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
