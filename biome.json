{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/fixtures",
      "!**/evals/private",
      "!**/dist",
      "!**/node_modules",
      "!**/*.tsbuildinfo"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
