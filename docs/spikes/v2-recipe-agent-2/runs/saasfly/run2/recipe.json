{
  "version": 1,
  "dependencies": [
    {"name": "next", "role": "framework", "note": "Next.js app router"},
    {"name": "kysely", "role": "data-access", "note": "Kysely queries"}
  ],
  "helpers": ["resolve-names", "const-strings"],
  "rules": [
    {
      "id": "prisma-models",
      "language": "text",
      "files": ["packages/db/prisma/schema.prisma"],
      "rule": {"regex": "^model\\s+(\\w+)\\s*\\{"},
      "emit": {"kind": "table", "name": "$1"},
      "examples": {"match": ["model User {\n  id String\n}"], "noMatch": ["enum Status {"]}
    },
    {
      "id": "kysely-read",
      "language": "typescript",
      "files": ["apps/**", "packages/**"],
      "rule": {"pattern": "$A.selectFrom($T)"},
      "emit": {"kind": "read", "table": "$T"},
      "examples": {"match": ["db.selectFrom(\"User\")"], "noMatch": ["db.insertInto(\"User\")"]}
    },
    {
      "id": "kysely-write-insert",
      "language": "typescript",
      "files": ["apps/**", "packages/**"],
      "rule": {"pattern": "$A.insertInto($T)"},
      "emit": {"kind": "write", "table": "$T"},
      "examples": {"match": ["db.insertInto(\"User\")"], "noMatch": ["db.selectFrom(\"User\")"]}
    },
    {
      "id": "kysely-write-update",
      "language": "typescript",
      "files": ["apps/**", "packages/**"],
      "rule": {"pattern": "$A.updateTable($T)"},
      "emit": {"kind": "write", "table": "$T"},
      "examples": {"match": ["db.updateTable(\"User\")"], "noMatch": ["db.selectFrom(\"User\")"]}
    },
    {
      "id": "kysely-write-delete",
      "language": "typescript",
      "files": ["apps/**", "packages/**"],
      "rule": {"pattern": "$A.deleteFrom($T)"},
      "emit": {"kind": "write", "table": "$T"},
      "examples": {"match": ["db.deleteFrom(\"User\")"], "noMatch": ["db.selectFrom(\"User\")"]}
    }
  ]
}
