{
  "version": 1,
  "dependencies": [
    { "name": "next", "role": "framework", "note": "Next.js app router" },
    { "name": "kysely", "role": "data-access", "note": "Kysely query builder over Prisma schema" }
  ],
  "helpers": ["fs-routes", "model-naming", "method-classes"],
  "rules": [
    {
      "id": "prisma-models",
      "language": "text",
      "files": ["**/schema.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "$1" },
      "examples": {
        "match": ["model User {\n  id String\n}"],
        "noMatch": ["enum Role {\n A\n}"]
      }
    },
    {
      "id": "kysely-read",
      "language": "typescript",
      "rule": { "pattern": "$R.selectFrom($T)" },
      "emit": { "kind": "read", "table": "$T" },
      "examples": {
        "match": ["db.selectFrom(\"User\").selectAll()"],
        "noMatch": ["db.insertInto(\"User\")"]
      }
    },
    {
      "id": "kysely-write-insert",
      "language": "typescript",
      "rule": { "pattern": "$R.insertInto($T)" },
      "emit": { "kind": "write", "table": "$T" },
      "examples": {
        "match": ["db.insertInto(\"User\").values(x)"],
        "noMatch": ["db.selectFrom(\"User\")"]
      }
    },
    {
      "id": "kysely-write-update",
      "language": "typescript",
      "rule": { "pattern": "$R.updateTable($T)" },
      "emit": { "kind": "write", "table": "$T" },
      "examples": {
        "match": ["db.updateTable(\"User\").set(x)"],
        "noMatch": ["db.selectFrom(\"User\")"]
      }
    },
    {
      "id": "kysely-write-delete",
      "language": "typescript",
      "rule": { "pattern": "$R.deleteFrom($T)" },
      "emit": { "kind": "write", "table": "$T" },
      "examples": {
        "match": ["db.deleteFrom(\"User\").execute()"],
        "noMatch": ["db.selectFrom(\"User\")"]
      }
    }
  ]
}
