{
  "version": 1,
  "dependencies": [],
  "helpers": [],
  "rules": [
    {
      "id": "gorm-models",
      "language": "text",
      "files": ["**/models.go"],
      "rule": { "regex": "^type (\\w+Model) struct" },
      "emit": { "kind": "table", "name": "$1" },
      "examples": {
        "match": ["type UserModel struct {\n}"],
        "noMatch": ["type UserSerializer struct {"]
      }
    }
  ]
}
