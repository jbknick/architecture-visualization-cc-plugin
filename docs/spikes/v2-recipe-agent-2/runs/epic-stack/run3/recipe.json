{"version":1,
"dependencies":[{"name":"react-router","role":"framework","note":"fs routes"},{"name":"@prisma/client","role":"data-access","note":"prisma"}],
"helpers":["model-naming","method-classes"],
"models":{"snakeCase":false,"plural":false},
"methods":{"read":["findMany","findFirst","findUnique","findFirstOrThrow","findUniqueOrThrow","count","aggregate","groupBy"],"write":["create","createMany","update","updateMany","upsert","delete","deleteMany"]},
"rules":[
{"id":"prisma-model","language":"text","files":["prisma/schema.prisma"],"rule":{"regex":"^model\\s+(\\w+)\\s*\\{"},"emit":{"kind":"table","name":"$1","model":"$1"},"examples":{"match":["model User {\n}"],"noMatch":["enum Role {"]}},
{"id":"prisma-read","language":"typescript","rule":{"pattern":"prisma.$M.$METHOD($$$A)"},"emit":{"kind":"read","model":"$M","method":"$METHOD"},"examples":{"match":["prisma.user.findMany({})"],"noMatch":["foo()"]}},
{"id":"prisma-write","language":"typescript","rule":{"pattern":"prisma.$M.$METHOD($$$A)"},"emit":{"kind":"write","model":"$M","method":"$METHOD"},"examples":{"match":["prisma.user.create({})"],"noMatch":["foo()"]}}
]}
