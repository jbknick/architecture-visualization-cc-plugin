{
 "version":1,
 "dependencies":[{"name":"fastify","role":"framework","note":"http"},{"name":"kysely","role":"data-access","note":"db"}],
 "helpers":["resolve-names","const-strings","mount-graph","call-return","param-flow","model-naming"],
 "passthrough":["register"],
 "methods":{"read":["selectFrom"],"write":["insertInto","updateTable","deleteFrom"]},
 "rules":[
  {"id":"fastify-router","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"kind":"required_parameter","has":{"kind":"type_annotation","regex":"FastifyInstance"}},
   "emit":{"kind":"router","data":{"adapter":"fastify"}},
   "examples":{"match":["async function f(fastify: FastifyInstance) {}"],"noMatch":["const a = 1"]}},
  {"id":"fastify-mount-prefix","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"pattern":"$P.register($C, { prefix: $PRE })"},
   "emit":{"kind":"mount","parent":"$P","child":"$C","prefix":"$PRE","childIsScope":true,"data":{"adapter":"fastify"}},
   "examples":{"match":["fastify.register(routes, { prefix: \"/users\" });"],"noMatch":["fastify.register(routes);"]}},
  {"id":"fastify-mount","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"pattern":"$P.register($C)"},
   "emit":{"kind":"mount","parent":"$P","child":"$C","childIsScope":true,"data":{"adapter":"fastify"}},
   "examples":{"match":["fastify.register(routes);"],"noMatch":["fastify.get(\"/\", h);"]}},
  {"id":"fastify-endpoint","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"pattern":"$R.$M($PATH, $$$REST)"},
   "constraints":{"M":{"regex":"^(get|post|put|patch|delete)$"}},
   "emit":{"kind":"endpoint","receiver":"$R","method":"$M","path":"$PATH","handler":"$$$REST","data":{"adapter":"fastify"}},
   "examples":{"match":["fastify.get(\"/\", h);"],"noMatch":["fastify.register(routes);"]}},
  {"id":"kysely-tables","language":"text","files":["apps/backend/src/db/types/index.ts"],
   "rule":{"regex":"^\\s+(\\w+): \\w+Table;"},
   "emit":{"kind":"table","name":"$1"},
   "examples":{"match":["  users: UsersTable;"],"noMatch":["export type X = 1;"]}},
  {"id":"kysely-read","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"pattern":"$DB.selectFrom($T)"},
   "emit":{"kind":"read","table":"$T"},
   "examples":{"match":["db.selectFrom(\"users\")"],"noMatch":["db.insertInto(\"users\")"]}},
  {"id":"kysely-write","language":"typescript","files":["apps/backend/src/**"],
   "rule":{"any":[{"pattern":"$DB.insertInto($T)"},{"pattern":"$DB.updateTable($T)"},{"pattern":"$DB.deleteFrom($T)"}]},
   "emit":{"kind":"write","table":"$T"},
   "examples":{"match":["db.insertInto(\"users\")"],"noMatch":["db.selectFrom(\"users\")"]}}
 ]
}
