{
  "version": 1,
  "dependencies": [],
  "helpers": ["text-rules"],
  "rules": [
    {
      "id": "schema-tables",
      "language": "text",
      "files": ["doc/schema.sql"],
      "rule": { "regex": "CREATE TABLE \"(\\w+)\"" },
      "emit": { "kind": "table", "name": "$1" },
      "examples": {
        "match": ["CREATE TABLE \"users\" ("],
        "noMatch": ["ALTER TABLE \"users\" ADD"]
      }
    }
  ]
}
