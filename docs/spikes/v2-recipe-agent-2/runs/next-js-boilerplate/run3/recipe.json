{
  "version": 1,
  "dependencies": [
    { "name": "next", "role": "framework", "note": "Next.js app router" },
    { "name": "drizzle-orm", "role": "data-access", "note": "pg tables" }
  ],
  "helpers": ["fs-routes", "model-naming"],
  "methods": { "read": ["findFirst", "findMany", "select"], "write": ["insert", "update", "delete"] },
  "rules": [
    {
      "id": "drizzle-table",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": { "pattern": "pgTable($NAME, $$$)" },
      "emit": { "kind": "table", "name": "$NAME", "binding": true },
      "examples": {
        "match": ["export const a = pgTable('counter', { id: serial('id') });"],
        "noMatch": ["const a = foo('counter');"]
      }
    },
    {
      "id": "drizzle-write",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": { "pattern": "$DB.$M($T)", "any": [{ "pattern": "$DB.insert($T)" }, { "pattern": "$DB.update($T)" }, { "pattern": "$DB.delete($T)" }] },
      "emit": { "kind": "write", "table": "$T" },
      "examples": {
        "match": ["db.insert(counterSchema).values({})"],
        "noMatch": ["db.foo(counterSchema)"]
      }
    },
    {
      "id": "drizzle-read",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": { "pattern": "$DB.query.$T.$M($$$)" },
      "emit": { "kind": "read", "model": "$T", "method": "$M" },
      "examples": {
        "match": ["db.query.counterSchema.findFirst({})"],
        "noMatch": ["db.counterSchema.findFirst({})"]
      }
    }
  ]
}
