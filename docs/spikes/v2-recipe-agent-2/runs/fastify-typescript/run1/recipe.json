{"version":1,
"dependencies":[{"name":"fastify","role":"framework","note":"http"},{"name":"@prisma/client","role":"data-access","note":"orm"}],
"helpers":["resolve-names","const-strings","mount-graph","model-naming"],
"passthrough":["register"],
"models":{"explicit":{"user":"users","post":"Post","User":"users","Post":"Post"}},
"methods":{"read":["findUnique","findFirst","findMany","count","findUniqueOrThrow","findFirstOrThrow"],"write":["create","update","delete","upsert","createMany","updateMany","deleteMany"]},
"rules":[
{"id":"fastify-server","language":"typescript","when":{"dependency":["fastify"]},
 "rule":{"pattern":"const $R = fastify($$$)"},"emit":{"kind":"router","data":{"adapter":"fastify"}},
 "examples":{"match":["const server = fastify({})"],"noMatch":["const server = other({})"]}},
{"id":"fastify-plugin","language":"typescript","when":{"dependency":["fastify"]},
 "rule":{"pattern":"async function $N($R: FastifyInstance) { $$$ }"},"emit":{"kind":"router","data":{"adapter":"fastify"}},
 "examples":{"match":["async function r(f: FastifyInstance) { }"],"noMatch":["async function r(f: Foo) { }"]}},
{"id":"fastify-mount","language":"typescript","when":{"dependency":["fastify"]},
 "rule":{"pattern":"$P.register($C, { prefix: $X })"},"emit":{"kind":"mount","parent":"$P","child":"$C","prefix":"$X","childIsScope":true,"data":{"adapter":"fastify"}},
 "examples":{"match":["server.register(userRouter, { prefix: '/api/user' })"],"noMatch":["server.register(cors)"]}},
{"id":"fastify-endpoint","language":"typescript","when":{"dependency":["fastify"]},
 "rule":{"pattern":"$R.$M($P, $$$H)"},"emit":{"kind":"endpoint","receiver":"$R","method":"$M","path":"$P","handler":"$H","data":{"adapter":"fastify"}},
 "examples":{"match":["server.get('/health', async () => {})"],"noMatch":["server.listen({})"]}},
{"id":"prisma-schema-mapped","language":"text","files":["prisma/schema.prisma"],
 "rule":{"regex":"^model \\w+ \\{[^}]*?@@map\\(\"(\\w+)\"\\)"},"emit":{"kind":"table","name":"$1"},
 "examples":{"match":["model U {\n id Int\n @@map(\"users\")\n}"],"noMatch":["model P {\n id Int\n}"]}},
{"id":"prisma-schema-plain","language":"text","files":["prisma/schema.prisma"],
 "rule":{"regex":"^model (\\w+) \\{(?:(?!@@map)[^}])*\\}"},"emit":{"kind":"table","name":"$1"},
 "examples":{"match":["model P {\n id Int\n}"],"noMatch":["model U {\n id Int\n @@map(\"users\")\n}"]}},
{"id":"prisma-read","language":"typescript","when":{"dependency":["@prisma/client"]},
 "rule":{"pattern":"prisma.$MODEL.$METHOD($$$)"},"emit":{"kind":"read","model":"$MODEL","method":"$METHOD"},
 "examples":{"match":["prisma.user.findUnique({})"],"noMatch":["foo.user.findUnique({})"]}},
{"id":"prisma-write","language":"typescript","when":{"dependency":["@prisma/client"]},
 "rule":{"pattern":"prisma.$MODEL.$METHOD($$$)"},"emit":{"kind":"write","model":"$MODEL","method":"$METHOD"},
 "examples":{"match":["prisma.post.create({})"],"noMatch":["foo.post.create({})"]}}
]}
