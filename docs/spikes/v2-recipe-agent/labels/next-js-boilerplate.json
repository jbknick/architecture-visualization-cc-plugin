    {
      "path": "/:locale/sign-up/*",
      "file": "src/app/[locale]/(auth)/(center)/sign-up/[[...sign-up]]/page.tsx"
    },
    {
      "path": "/:locale/sign-in/*",
      "file": "src/app/[locale]/(auth)/(center)/sign-in/[[...sign-in]]/page.tsx"
    }
  ],
  "endpoint": [{ "method": "PUT", "path": "/api/counter", "file": "src/app/api/counter/route.ts" }],
  "table": [{ "name": "counter" }]
