{
  "name": "hono-tanstack-drizzle",
  "frameworks": [
    { "name": "hono", "evidence": "apps/api dependency" },
    { "name": "tanstack-router", "evidence": "createFileRoute" },
    { "name": "drizzle", "evidence": "sqliteTable" }
  ],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "passthrough": ["basePath"],
  "rules": [
    {
      "id": "hono-router",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "new Hono()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["new Hono()"], "noMatch": ["new Map()"] }
    },
    {
      "id": "hono-endpoint",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|options|all)$" },
        "P": { "kind": "string" }
      },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$$H" },
      "examples": { "match": ["app.get(\"/x\", h)"], "noMatch": ["app.get(key)"] }
    },
    {
      "id": "tanstack-route",
      "language": "typescript",
      "files": ["apps/web/src/routes/**/*.tsx"],
      "rule": { "pattern": "createFileRoute($P)" },
      "constraints": { "P": { "kind": "string" } },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/web/src/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\.", "with": "/" }, { "regex": "/index$", "with": "/" }]
        }
      },
      "examples": { "match": ["createFileRoute(\"/x\")({})"], "noMatch": ["createRootRoute({})"] }
    },
    {
      "id": "drizzle-table",
      "language": "typescript",
      "files": ["packages/*/src/**/*.ts"],
      "rule": { "pattern": "sqliteTable($N, $$A)" },
      "constraints": { "N": { "kind": "string" } },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["sqliteTable(\"users\", {})"], "noMatch": ["foo(\"users\", {})"] }
    }
  ]
}
