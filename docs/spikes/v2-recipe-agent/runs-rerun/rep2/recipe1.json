{
  "name": "hono-tanstack-drizzle",
  "frameworks": [
    { "name": "hono", "evidence": "package.json" },
    { "name": "drizzle-orm", "evidence": "package.json" },
    { "name": "tanstack-router", "evidence": "package.json" }
  ],
  "helpers": ["resolve-names", "const-strings", "mount-graph"],
  "rules": [
    {
      "id": "hono-router",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "new Hono()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["new Hono()"], "noMatch": ["new Foo()"] }
    },
    {
      "id": "hono-endpoint",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|options|all)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": { "match": ["app.get('/x', h)"], "noMatch": ["app.foo('/x', h)"] }
    },
    {
      "id": "drizzle-table",
      "language": "typescript",
      "files": ["packages/db/src/**/*.ts"],
      "rule": {
        "any": [
          { "pattern": "sqliteTable($N, $$A)" },
          { "pattern": "pgTable($N, $$A)" },
          { "pattern": "mysqlTable($N, $$A)" }
        ]
      },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["sqliteTable('users', {})"], "noMatch": ["foo('users', {})"] }
    },
    {
      "id": "tanstack-route",
      "language": "text",
      "files": ["apps/web/src/routes/**/*.tsx"],
      "rule": { "regex": "createFileRoute\\(" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/web/src/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "/index$", "with": "" },
            { "regex": "\\.", "with": "/" },
            { "regex": "^$", "with": "/" }
          ]
        }
      },
      "examples": { "match": ["createFileRoute(\"/\")"], "noMatch": ["createRoute()"] }
    }
  ]
}
