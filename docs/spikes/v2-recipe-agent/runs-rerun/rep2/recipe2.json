{
  "name": "hono-tanstack-drizzle",
  "frameworks": [
    { "name": "hono", "evidence": "package.json" },
    { "name": "drizzle-orm", "evidence": "package.json" },
    { "name": "tanstack-router", "evidence": "package.json" },
    { "name": "express", "evidence": "apps/express/package.json" },
    { "name": "prisma", "evidence": "apps/express/package.json" }
  ],
  "helpers": ["resolve-names", "const-strings", "mount-graph"],
  "rules": [
    {
      "id": "hono-router",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "new Hono()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["new Hono()"], "noMatch": ["new Foo()"] }
    },
    {
      "id": "hono-endpoint",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|options|all)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": { "match": ["app.get('/x', h)"], "noMatch": ["app.foo('/x', h)"] }
    },
    {
      "id": "drizzle-table",
      "language": "typescript",
      "files": ["packages/db/src/**/*.ts"],
      "rule": {
        "any": [
          { "pattern": "sqliteTable($N, $$A)" },
          { "pattern": "pgTable($N, $$A)" },
          { "pattern": "mysqlTable($N, $$A)" }
        ]
      },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["sqliteTable('users', {})"], "noMatch": ["foo('users', {})"] }
    },
    {
      "id": "tanstack-route",
      "language": "text",
      "files": ["apps/web/src/routes/**/*.tsx"],
      "rule": { "regex": "createFileRoute\\(" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/web/src/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "/index$", "with": "" },
            { "regex": "\\.", "with": "/" },
            { "regex": "^$", "with": "/" }
          ]
        }
      },
      "examples": { "match": ["createFileRoute(\"/\")"], "noMatch": ["createRoute()"] }
    },
    {
      "id": "express-router",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "any": [{ "pattern": "express()" }, { "pattern": "express.Router()" }] },
      "emit": { "kind": "router" },
      "examples": { "match": ["express()", "express.Router()"], "noMatch": ["foo()"] }
    },
    {
      "id": "express-endpoint",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|options|all)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": { "match": ["api.get('/x', h)"], "noMatch": ["api.foo('/x', h)"] }
    },
    {
      "id": "express-mount",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "pattern": "$P.use($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["app.use('/api', api)"], "noMatch": ["app.get('/api', api)"] }
    },
    {
      "id": "prisma-model",
      "language": "text",
      "files": ["apps/express/prisma/schema.prisma"],
      "rule": { "regex": "model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model Item {"], "noMatch": ["enum Foo {"] }
    }
  ],
  "dismissed": {
    "dependencies": [
      { "name": "@orpc/server", "reason": "oRPC procedures, not method+path" },
      { "name": "react", "reason": "UI library, not a registration" },
      { "name": "@tanstack/react-router", "reason": "covered by tanstack-route rule" },
      { "name": "@prisma/client", "reason": "covered by prisma-model rule" },
      { "name": "express", "reason": "covered by express rules" }
    ],
    "sites": []
  }
}
