{
  "name": "hono-tanstack-drizzle",
  "frameworks": [
    { "name": "hono", "evidence": "package.json" },
    { "name": "tanstack-router", "evidence": "createFileRoute" },
    { "name": "drizzle", "evidence": "package.json" },
    { "name": "express", "evidence": "apps/express/package.json" },
    { "name": "prisma", "evidence": "schema.prisma" }
  ],
  "helpers": ["resolve-names", "const-strings", "mount-graph"],
  "rules": [
    {
      "id": "hono-router",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "new Hono()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["new Hono()"], "noMatch": ["new Map()"] }
    },
    {
      "id": "hono-endpoint",
      "language": "typescript",
      "files": ["apps/api/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|delete|patch)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$$H" },
      "examples": { "match": ["app.get(\"/x\", (c) => c.json(1))"], "noMatch": ["map.set(1)"] }
    },
    {
      "id": "tanstack-route",
      "language": "typescript",
      "files": ["apps/web/src/routes/**/*.tsx"],
      "rule": { "pattern": "createFileRoute($P)" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/web/src/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\.", "with": "/" },
            { "regex": "/index$", "with": "" },
            { "regex": "^/__root$", "with": "" }
          ]
        }
      },
      "examples": { "match": ["createFileRoute(\"/x\")({})"], "noMatch": ["createRoute({})"] }
    },
    {
      "id": "drizzle-table",
      "language": "typescript",
      "files": ["packages/db/src/**/*.ts"],
      "rule": { "pattern": "sqliteTable($N, $$A)" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["sqliteTable(\"users\", {})"], "noMatch": ["text(\"id\")"] }
    },
    {
      "id": "express-router",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "any": [{ "pattern": "express()" }, { "pattern": "express.Router()" }] },
      "emit": { "kind": "router" },
      "examples": { "match": ["express()", "express.Router()"], "noMatch": ["new Map()"] }
    },
    {
      "id": "express-endpoint",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "pattern": "$R.$M($P, $$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|delete|patch)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$$H" },
      "examples": { "match": ["api.get(\"/x\", (req, res) => {})"], "noMatch": ["map.set(1)"] }
    },
    {
      "id": "express-mount",
      "language": "typescript",
      "files": ["apps/express/src/**/*.ts"],
      "rule": { "pattern": "$P.use($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["app.use(\"/api\", api)"], "noMatch": ["app.listen(3000)"] }
    },
    {
      "id": "prisma-model",
      "language": "text",
      "files": ["apps/express/prisma/schema.prisma"],
      "rule": { "regex": "model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model Item {"], "noMatch": ["datasource db {"] }
    }
  ],
  "dismissed": {
    "dependencies": [
      { "name": "@orpc/server", "reason": "RPC procedures, not method+path" },
      { "name": "react", "reason": "UI library" },
      { "name": "@tanstack/react-router", "reason": "covered by tanstack-route rule" },
      { "name": "drizzle-orm", "reason": "covered by drizzle-table rule" },
      { "name": "@prisma/client", "reason": "covered by prisma-model rule" },
      { "name": "express", "reason": "covered by express rules" }
    ],
    "sites": []
  }
}
