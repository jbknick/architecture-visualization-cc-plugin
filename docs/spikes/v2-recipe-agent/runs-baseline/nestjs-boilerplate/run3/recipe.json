{
  "name": "nestjs-boilerplate",
  "frameworks": [{ "name": "nestjs", "evidence": "package.json dependency" }],
  "when": { "dependency": ["@nestjs/common"] },
  "helpers": [],
  "rules": [
    {
      "id": "nest-auth",
      "language": "typescript",
      "files": ["src/auth/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/auth" },
      "examples": { "match": ["class A {\n  @Get('me')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-auth-apple",
      "language": "typescript",
      "files": ["src/auth-apple/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/auth/apple" },
      "examples": { "match": ["class A {\n  @Post('login')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-auth-facebook",
      "language": "typescript",
      "files": ["src/auth-facebook/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/auth/facebook" },
      "examples": { "match": ["class A {\n  @Post('login')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-auth-google",
      "language": "typescript",
      "files": ["src/auth-google/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/auth/google" },
      "examples": { "match": ["class A {\n  @Post('login')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-files",
      "language": "typescript",
      "files": ["src/files/**/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/files" },
      "examples": { "match": ["class A {\n  @Post('upload')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-users",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "pattern": "@$M($P)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$P", "prefix": "=/api/v1/users" },
      "examples": { "match": ["class A {\n  @Get(':id')\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-users-root",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "pattern": "@$M()", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "=", "prefix": "=/api/v1/users" },
      "examples": { "match": ["class A {\n  @Get()\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "nest-home",
      "language": "typescript",
      "files": ["src/home/*.controller.ts"],
      "rule": { "pattern": "@Get()", "inside": { "kind": "class_body" } },
      "emit": { "kind": "endpoint", "method": "=GET", "path": "=/", "standalone": true },
      "examples": { "match": ["class A {\n  @Get()\n  m() {}\n}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "typeorm-entity",
      "language": "typescript",
      "files": ["src/**/*.entity.ts"],
      "rule": { "pattern": "@Entity({ name: $N })" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["@Entity({ name: 'file' })\nclass A {}"], "noMatch": ["class A {}"] }
    }
  ]
}
