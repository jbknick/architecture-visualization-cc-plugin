{
  "name": "nestjs-boilerplate",
  "frameworks": [{ "name": "nestjs", "evidence": "package.json dependency" }],
  "when": { "dependency": ["@nestjs/common"] },
  "helpers": [],
  "rules": [
    {
      "id": "nest-auth",
      "language": "typescript",
      "files": ["src/auth/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/auth" },
      "examples": {
        "match": ["class A {\n  @Get('me')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-auth-apple",
      "language": "typescript",
      "files": ["src/auth-apple/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/auth/apple" },
      "examples": {
        "match": ["class A {\n  @Post('login')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-auth-facebook",
      "language": "typescript",
      "files": ["src/auth-facebook/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/auth/facebook" },
      "examples": {
        "match": ["class A {\n  @Post('login')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-auth-google",
      "language": "typescript",
      "files": ["src/auth-google/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/auth/google" },
      "examples": {
        "match": ["class A {\n  @Post('login')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-files",
      "language": "typescript",
      "files": ["src/files/**/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/files" },
      "examples": {
        "match": ["class A {\n  @Post('upload')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-users",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "$X", "prefix": "=/api/v1/users" },
      "examples": {
        "match": ["class A {\n  @Get(':id')\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get()\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-users-root",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M()", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "=", "prefix": "=/api/v1/users" },
      "examples": {
        "match": ["class A {\n  @Get()\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get(':id')\n  f() {}\n}"]
      }
    },
    {
      "id": "nest-home",
      "language": "typescript",
      "files": ["src/home/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M()", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "=/", "standalone": true },
      "examples": {
        "match": ["@Controller()\nclass A {\n  @Get()\n  f() {}\n}"],
        "noMatch": ["class A {\n  @Get(':id')\n  f() {}\n}"]
      }
    },
    {
      "id": "typeorm-entity",
      "language": "typescript",
      "files": ["src/**/*.entity.ts"],
      "rule": { "pattern": "@Entity({ name: $N })" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": {
        "match": ["@Entity({ name: 'role' })\nclass R {}"],
        "noMatch": ["class R {}"]
      }
    },
    {
      "id": "mongoose-schema",
      "language": "text",
      "files": ["src/**/*.schema.ts"],
      "rule": { "regex": "@Schema\\([\\s\\S]*?\\)\\s*export class (\\w+)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": {
        "match": ["@Schema({ timestamps: true })\nexport class UserSchemaClass {}"],
        "noMatch": ["export class X {}"]
      }
    }
  ]
}
