{
  "name": "nestjs-boilerplate",
  "frameworks": [{ "name": "nestjs", "evidence": "package.json dependency" }],
  "when": { "dependency": ["@nestjs/common"] },
  "helpers": [],
  "rules": [
    {
      "id": "nest-auth-apple",
      "language": "typescript",
      "files": ["src/auth-apple/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/auth/apple"
      },
      "examples": { "match": ["class A { @Post('x') f() {} }"], "noMatch": ["class A { @Foo('x') f() {} }"] }
    },
    {
      "id": "nest-auth-facebook",
      "language": "typescript",
      "files": ["src/auth-facebook/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/auth/facebook"
      },
      "examples": { "match": ["class A { @Post('x') f() {} }"], "noMatch": ["class A { @Foo('x') f() {} }"] }
    },
    {
      "id": "nest-auth-google",
      "language": "typescript",
      "files": ["src/auth-google/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/auth/google"
      },
      "examples": { "match": ["class A { @Post('x') f() {} }"], "noMatch": ["class A { @Foo('x') f() {} }"] }
    },
    {
      "id": "nest-auth",
      "language": "typescript",
      "files": ["src/auth/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/auth"
      },
      "examples": { "match": ["class A { @Post('x') f() {} }"], "noMatch": ["class A { @Foo('x') f() {} }"] }
    },
    {
      "id": "nest-files",
      "language": "typescript",
      "files": ["src/files/**/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/files"
      },
      "examples": { "match": ["class A { @Post('x') f() {} }"], "noMatch": ["class A { @Foo('x') f() {} }"] }
    },
    {
      "id": "nest-users",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "pattern": "@$M($P)", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$P",
        "standalone": true,
        "prefix": "=/api/v1/users"
      },
      "examples": {
        "match": ["class A { @Patch(':id') f() {} }"],
        "noMatch": ["class A { @Foo('x') f() {} }"]
      }
    },
    {
      "id": "nest-users-nopath",
      "language": "typescript",
      "files": ["src/users/*.controller.ts"],
      "rule": { "pattern": "@$M()", "kind": "decorator", "inside": { "kind": "class_body" } },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "=",
        "standalone": true,
        "prefix": "=/api/v1/users"
      },
      "examples": { "match": ["class A { @Get() f() {} }"], "noMatch": ["class A { @Get('x') f() {} }"] }
    },
    {
      "id": "nest-home",
      "language": "typescript",
      "files": ["src/home/home.controller.ts"],
      "rule": { "pattern": "@Get()", "kind": "decorator" },
      "emit": { "kind": "endpoint", "method": "=GET", "path": "=/", "standalone": true },
      "examples": { "match": ["class A { @Get() f() {} }"], "noMatch": ["class A { @Get('x') f() {} }"] }
    },
    {
      "id": "nest-entity-tables",
      "language": "typescript",
      "files": ["src/**/*.entity.ts"],
      "rule": { "pattern": "@Entity({ name: $N })" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["@Entity({ name: 'user' })\nclass A {}"], "noMatch": ["@Entity()\nclass A {}"] }
    }
  ]
}
