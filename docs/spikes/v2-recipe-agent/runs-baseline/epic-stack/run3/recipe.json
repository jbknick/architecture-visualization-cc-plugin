{
  "name": "epic-stack",
  "frameworks": [{ "name": "react-router", "evidence": "react-router-auto-routes in app/routes.ts" }],
  "helpers": [],
  "rules": [
    {
      "id": "page-routes",
      "language": "text",
      "files": [
        "app/routes/*.tsx",
        "app/routes/_*/**/*.tsx",
        "app/routes/admin/**/*.tsx",
        "app/routes/resources/*.tsx",
        "app/routes/settings/**/*.tsx",
        "app/routes/users/**/*.tsx"
      ],
      "rule": { "regex": "export default (?:async )?(?:function|[A-Za-z])" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^app/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\[\\.\\]", "with": "~DOT~" },
            { "regex": "^(/_[^/]+)+/", "with": "/" },
            { "regex": "/_layout$", "with": "" },
            { "regex": "/index$", "with": "" },
            { "regex": "_(?=[./]|$)", "with": "" },
            { "regex": "\\.", "with": "/" },
            { "regex": "~DOT~", "with": "." },
            { "regex": "^$", "with": "/" }
          ]
        }
      },
      "examples": {
        "match": ["export default function Foo() {}"],
        "noMatch": ["export async function loader() {}"]
      }
    },
    {
      "id": "resource-routes",
      "language": "text",
      "files": [
        "app/routes/*.ts",
        "app/routes/*.tsx",
        "app/routes/_*/**/*.ts",
        "app/routes/_*/**/*.tsx",
        "app/routes/resources/*.ts",
        "app/routes/resources/*.tsx",
        "app/routes/admin/cache/*.$cacheKey.ts"
      ],
      "rule": {
        "regex": "(?<![\\s\\S])(?![\\s\\S]*export default)[\\s\\S]*export (?:async )?function (?:loader|action)"
      },
      "emit": {
        "kind": "endpoint",
        "method": "=ALL",
        "pathFromFile": {
          "pattern": "^app/routes/(.*)\\.tsx?$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\[\\.\\]", "with": "~DOT~" },
            { "regex": "^(/_[^/]+)+/", "with": "/" },
            { "regex": "/index$", "with": "" },
            { "regex": "_(?=[./]|$)", "with": "" },
            { "regex": "\\.", "with": "/" },
            { "regex": "~DOT~", "with": "." },
            { "regex": "^$", "with": "/" }
          ]
        }
      },
      "examples": {
        "match": ["export async function loader() {}"],
        "noMatch": ["export default function A() {}\nexport async function loader() {}"]
      }
    },
    {
      "id": "prisma-models",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model User {\n}"], "noMatch": ["enum Role {"] }
    }
  ]
}
