{
  "name": "epic-stack",
  "frameworks": [{ "name": "react-router", "evidence": "app/routes.ts autoRoutes" }],
  "helpers": [],
  "rules": [
    {
      "id": "routes-pages",
      "language": "text",
      "files": ["app/routes/**/*.tsx"],
      "rule": { "regex": "export default (?:async )?(?:function|class)?" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^app/routes/(?!.*(?:\\+|\\.server\\.|\\.client\\.|\\.test\\.|/_layout\\.))(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "/_[a-z]+(?=/)", "with": "" },
            { "regex": "/index$", "with": "/" },
            { "regex": "\\.", "with": "/" },
            { "regex": "_(?=/|$)", "with": "" }
          ]
        }
      },
      "examples": { "match": ["export default function A() {}"], "noMatch": ["export function loader() {}"] }
    },
    {
      "id": "routes-resources",
      "language": "text",
      "files": ["app/routes/**/*.ts", "app/routes/**/*.tsx"],
      "rule": {
        "regex": "(?<![\\s\\S])(?![\\s\\S]*export default)[\\s\\S]*?export (?:async )?function (?:loader|action)"
      },
      "emit": {
        "kind": "endpoint",
        "method": "=ALL",
        "pathFromFile": {
          "pattern": "^app/routes/(?!.*(?:\\+|\\.server\\.|\\.client\\.|\\.test\\.|/_layout\\.))(.*)\\.tsx?$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\[\\.\\]", "with": "~" },
            { "regex": "/_[a-z]+(?=/)", "with": "" },
            { "regex": "/index$", "with": "" },
            { "regex": "\\.", "with": "/" },
            { "regex": "~", "with": "." },
            { "regex": "_(?=/|$)", "with": "" }
          ]
        }
      },
      "examples": {
        "match": ["export async function loader() {}"],
        "noMatch": ["export default function A() {}\nexport function loader() {}"]
      }
    },
    {
      "id": "prisma-models",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model User {\n}"], "noMatch": ["enum X {"] }
    }
  ]
}
