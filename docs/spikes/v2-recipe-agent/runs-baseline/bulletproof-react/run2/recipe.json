{
  "name": "bulletproof-react",
  "frameworks": [
    { "name": "nextjs", "evidence": "apps/nextjs-* package.json" },
    { "name": "react-router", "evidence": "apps/react-vite" }
  ],
  "helpers": [],
  "rules": [
    {
      "id": "next-app-pages",
      "language": "text",
      "files": ["apps/nextjs-app/src/app/**/page.tsx"],
      "rule": { "regex": "import|export" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs-app/src/app/(.*)page\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\([^/]*\\)/", "with": "" }]
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "next-pages-router",
      "language": "text",
      "files": ["apps/nextjs-pages/src/pages/**/*.tsx"],
      "rule": { "regex": "export\\s+(default\\s+(?!function App)|\\{)" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs-pages/src/pages/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "index$", "with": "" }]
        }
      },
      "examples": {
        "match": ["export default function Page() {}", "export { X as default } from './x';"],
        "noMatch": ["const a = 1;", "export default function App() {}"]
      }
    },
    {
      "id": "vite-landing",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/landing.tsx"],
      "rule": { "regex": "import|export" },
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^.*$", "template": "/" } },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-auth",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/auth/*.tsx"],
      "rule": { "regex": "import|export" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/react-vite/src/app/routes/auth/(.*)\\.tsx$",
          "template": "/auth/$1"
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-app",
      "language": "text",
      "files": [
        "apps/react-vite/src/app/routes/app/users.tsx",
        "apps/react-vite/src/app/routes/app/profile.tsx"
      ],
      "rule": { "regex": "import|export" },
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/react-vite/src/app/routes/app/(.*)\\.tsx$",
          "template": "/app/$1"
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-dashboard",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/dashboard.tsx"],
      "rule": { "regex": "import|export" },
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^.*$", "template": "/app" } },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-discussions",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/discussions/discussions.tsx"],
      "rule": { "regex": "import|export" },
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^.*$", "template": "/app/discussions" } },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-discussion",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/discussions/discussion.tsx"],
      "rule": { "regex": "import|export" },
      "emit": {
        "kind": "route",
        "pathFromFile": { "pattern": "^.*$", "template": "/app/discussions/:discussionId" }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    },
    {
      "id": "vite-notfound",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/not-found.tsx"],
      "rule": { "regex": "import|export" },
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^.*$", "template": "/*" } },
      "examples": { "match": ["export default function P() {}"], "noMatch": ["const a = 1;"] }
    }
  ]
}
