{
  "name": "bun-fastify-kysely",
  "frameworks": [
    { "name": "fastify", "evidence": "package.json dependency" },
    { "name": "kysely", "evidence": "Database interface" }
  ],
  "when": { "dependency": ["fastify"] },
  "passthrough": ["withTypeProvider", "setValidatorCompiler"],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["apps/backend/src/server.ts"],
      "rule": { "pattern": "Fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["Fastify({})"], "noMatch": ["Foo({})"] }
    },
    {
      "id": "mount-prefix",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["fastify.register(routes, { prefix: \"/users\" })"],
        "noMatch": ["fastify.register(routes)"]
      }
    },
    {
      "id": "mount-plain",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["fastify.register(routes)"], "noMatch": ["fastify.register(routes, {})"] }
    },
    {
      "id": "root-get",
      "language": "typescript",
      "files": ["apps/backend/src/api/index.ts"],
      "rule": { "pattern": "$R.get($X, $H)" },
      "emit": { "kind": "endpoint", "method": "=GET", "path": "$X", "handler": "$H", "standalone": true },
      "examples": { "match": ["fastify.get(\"/\", async () => {})"], "noMatch": ["fastify.listen({})"] }
    },
    {
      "id": "users-endpoint",
      "language": "typescript",
      "files": ["apps/backend/src/api/users/*.route.ts"],
      "rule": { "pattern": "$R.$M($X, $O, $H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$X",
        "handler": "$H",
        "prefix": "=/users",
        "standalone": true
      },
      "examples": {
        "match": ["fastify.post(\"/email\", { schema: {} }, ctrl)"],
        "noMatch": ["fastify.listen({})"]
      }
    },
    {
      "id": "tables",
      "language": "text",
      "files": ["apps/backend/src/db/types/index.ts"],
      "rule": { "regex": "^\\s+(\\w+):\\s*\\w+Table;" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": {
        "match": ["export interface Database {\n  users: UsersTable;\n}"],
        "noMatch": ["interface Foo { a: string }"]
      }
    }
  ]
}
