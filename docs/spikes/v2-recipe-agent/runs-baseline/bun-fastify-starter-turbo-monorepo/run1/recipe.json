{
  "name": "bun-fastify-starter",
  "frameworks": [
    { "name": "fastify", "evidence": "package.json dependency" },
    { "name": "kysely", "evidence": "Database interface" }
  ],
  "when": { "dependency": ["fastify"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "fastify-instance-param",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "kind": "required_parameter", "regex": "FastifyInstance" },
      "emit": { "kind": "router" },
      "examples": { "match": ["function _(f: FastifyInstance) {}"], "noMatch": ["function _(f: string) {}"] }
    },
    {
      "id": "fastify-register-prefix",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["fastify.register(routes, { prefix: \"/users\" })"],
        "noMatch": ["fastify.register(routes)"]
      }
    },
    {
      "id": "fastify-register",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["fastify.register(routes)"], "noMatch": ["fastify.get('/x', h)"] }
    },
    {
      "id": "fastify-endpoint",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": {
        "any": [
          { "pattern": "$R.$M($X)" },
          { "pattern": "$R.$M($X, $A)" },
          { "pattern": "$R.$M($X, $A, $B)" },
          { "pattern": "$R.$M($X, $A, $B, $C)" }
        ]
      },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|head|options|all)$" },
        "X": { "regex": "^[\"'`]" }
      },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": {
        "match": ["fastify.post(\"/email\", {}, h)", "fastify.get(\"/\", h)"],
        "noMatch": ["map.get(key)"]
      }
    },
    {
      "id": "kysely-tables",
      "language": "text",
      "files": ["apps/backend/src/db/types/index.ts"],
      "rule": { "regex": "^\\s+(\\w+): \\w+Table;" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["  users: UsersTable;"], "noMatch": ["  id: string;"] }
    }
  ]
}
