{
  "name": "go-base",
  "frameworks": [{ "name": "chi", "evidence": "go.mod" }],
  "when": { "imports": ["github.com/go-chi/chi/v5"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "chi-router",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "chi.NewRouter()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["chi.NewRouter()"], "noMatch": ["chi.NewMux2()"] }
    },
    {
      "id": "chi-endpoint",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.$M($P, $H)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Delete|Patch|Head|Options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": { "match": ["r.Get(\"/x\", h)"], "noMatch": ["r.Foo(\"/x\", h)"] }
    },
    {
      "id": "chi-mount",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$P.Mount($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["r.Mount(\"/a\", b.Router())"], "noMatch": ["r.Use(x)"] }
    },
    {
      "id": "chi-route",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$P.Route($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": { "match": ["r.Route(\"/a\", func(r chi.Router) {})"], "noMatch": ["r.Use(x)"] }
    },
    {
      "id": "chi-group",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": { "context": "func _() { $P.Group($C) }", "selector": "call_expression" } },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["r.Group(func(r chi.Router) {})"], "noMatch": ["r.Use(x)"] }
    },
    {
      "id": "sql-tables",
      "language": "text",
      "files": ["database/migrations/**/*.go", "database/migrations/**/*.sql"],
      "rule": { "regex": "CREATE TABLE (?:IF NOT EXISTS )?(\\w+)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["CREATE TABLE accounts ("], "noMatch": ["DROP TABLE accounts"] }
    }
  ]
}
