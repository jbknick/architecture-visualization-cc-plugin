{
  "name": "simplebank",
  "frameworks": [{ "name": "gin", "evidence": "go.mod" }],
  "when": { "imports": ["github.com/gin-gonic/gin"] },
  "passthrough": ["Use"],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "gin-router",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "gin.Default()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["gin.Default()"], "noMatch": ["gin.New()"] }
    },
    {
      "id": "gin-group",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": {
        "any": [
          {
            "pattern": { "context": "func _() { $C := $P.Group($X) }", "selector": "short_var_declaration" }
          },
          {
            "pattern": {
              "context": "func _() { $C := $P.Group($X).Use($$A) }",
              "selector": "short_var_declaration"
            }
          }
        ]
      },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": {
        "match": ["func f() { a := r.Group(\"/a\").Use(m) }", "func f() { a := r.Group(\"/a\") }"],
        "noMatch": ["func f() { a := r.Get(\"/a\") }"]
      }
    },
    {
      "id": "gin-endpoint",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "$R.$M($X, $$H)" },
      "constraints": { "M": { "regex": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|Any)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X", "handler": "$H" },
      "examples": { "match": ["r.POST(\"/users\", h)"], "noMatch": ["m.Get(\"/users\")"] }
    },
    {
      "id": "sql-tables",
      "language": "text",
      "files": ["db/migration/*.up.sql"],
      "rule": { "regex": "CREATE TABLE \"?(\\w+)\"?" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["CREATE TABLE \"users\" ("], "noMatch": ["DROP TABLE users"] }
    },
    {
      "id": "vue-route-home",
      "language": "text",
      "files": ["frontend/src/router/index.ts"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^.*$", "template": "/" } },
      "examples": { "match": ["routes: [{ path: '/' }]"], "noMatch": [] }
    }
  ]
}
