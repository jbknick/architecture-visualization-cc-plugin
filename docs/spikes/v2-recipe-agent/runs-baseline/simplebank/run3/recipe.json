{
  "name": "simplebank",
  "frameworks": [{ "name": "gin", "evidence": "go.mod" }],
  "when": { "imports": ["github.com/gin-gonic/gin"] },
  "passthrough": ["Use"],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "gin-router",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "gin.Default()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["gin.Default()"], "noMatch": ["gin.New()"] }
    },
    {
      "id": "gin-group",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": {
        "any": [
          { "pattern": { "context": "func _() { $P.Group($X) }", "selector": "call_expression" } },
          { "pattern": "$P.Group($X, $$MW)" }
        ]
      },
      "emit": { "kind": "router", "base": "$X" },
      "examples": { "match": ["r.Group(\"/a\", mw)", "r.Group(\"/a\")"], "noMatch": ["r.Get(\"/a\")"] }
    },
    {
      "id": "gin-endpoint",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "$R.$M($X, $$H)" },
      "constraints": { "M": { "regex": "^(GET|POST|PUT|DELETE|PATCH)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X", "handler": "$H" },
      "examples": { "match": ["r.POST(\"/users\", h)"], "noMatch": ["m.Get(k)"] }
    },
    {
      "id": "sql-tables",
      "language": "text",
      "files": ["db/migration/*.up.sql"],
      "rule": { "regex": "CREATE TABLE\\s+\"?(\\w+)\"?" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["CREATE TABLE \"users\" ("], "noMatch": ["ALTER TABLE \"users\""] }
    }
  ]
}
