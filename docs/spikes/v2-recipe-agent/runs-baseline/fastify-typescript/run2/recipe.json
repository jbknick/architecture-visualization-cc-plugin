{
  "name": "fastify-ts",
  "frameworks": [{ "name": "fastify", "evidence": "package.json dependency" }],
  "when": { "dependency": ["fastify"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["fastify({})"], "noMatch": ["foo({})"] }
    },
    {
      "id": "register",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["server.register(userRouter, { prefix: '/api/user' })"],
        "noMatch": ["server.register(cors)"]
      }
    },
    {
      "id": "endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "any": [{ "pattern": "$R.$M($P, $H)" }, { "pattern": "$R.$M($P, $O, $H)" }] },
      "constraints": {
        "M": { "regex": "^(get|post|put|delete|patch|head|options|all)$" },
        "P": { "regex": "^['\"`]" }
      },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": {
        "match": ["fastify.post('/a', {}, h)", "server.get('/', h)"],
        "noMatch": ["map.get(key)"]
      }
    },
    {
      "id": "prisma",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model Post {"], "noMatch": ["enum A {"] }
    }
  ]
}
