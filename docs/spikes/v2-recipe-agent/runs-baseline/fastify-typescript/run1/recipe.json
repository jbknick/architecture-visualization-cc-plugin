{
  "name": "fastify-ts",
  "frameworks": [
    { "name": "fastify", "evidence": "package.json dependency" },
    { "name": "prisma", "evidence": "schema.prisma" }
  ],
  "when": { "dependency": ["fastify"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["const s = fastify({})"], "noMatch": ["const s = other({})"] }
    },
    {
      "id": "register",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["server.register(userRouter, { prefix: '/api/user' })"],
        "noMatch": ["server.register(cors)"]
      }
    },
    {
      "id": "endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "any": [{ "pattern": "$R.$M($X, $A, $H)" }, { "pattern": "$R.$M($X, $H)" }] },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|head|options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": {
        "match": ["fastify.post('/login', {}, h)", "server.get('/health', async () => {})"],
        "noMatch": ["fastify.decorate('x', 1)"]
      }
    },
    {
      "id": "prisma-mapped",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "^model\\s+\\w+\\s*\\{[^}]*?@@map\\(\"(\\w+)\"\\)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model User {\n  id Int\n  @@map(\"users\")\n}"], "noMatch": ["enum Role {"] }
    },
    {
      "id": "prisma-plain",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{(?:(?!@@map)[^}])*\\}" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": {
        "match": ["model Post {\n  id Int\n}"],
        "noMatch": ["model User {\n @@map(\"users\")\n}"]
      }
    }
  ]
}
