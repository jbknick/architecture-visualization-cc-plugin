{
  "name": "express-mongodb-boilerplate",
  "frameworks": [
    { "name": "express", "evidence": "package.json dependency" },
    { "name": "mongoose", "evidence": "models" }
  ],
  "when": { "dependency": ["express"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "any": [{ "pattern": "Router()" }, { "pattern": "Router($O)" }, { "pattern": "express()" }] },
      "emit": { "kind": "router" },
      "examples": { "match": ["Router()", "express()"], "noMatch": ["foo()"] }
    },
    {
      "id": "mount-prefixed",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.use($X, $C)" },
      "constraints": { "X": { "regex": "^['\"`]" } },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["router.use('/docs/', docs)"], "noMatch": ["router.use(a, b)"] }
    },
    {
      "id": "mount-plain",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.use($$$A, $C, $$$B)" },
      "constraints": { "C": { "regex": "^[A-Za-z_]\\w*(\\(.*\\))?$" } },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C" },
      "examples": {
        "match": ["router.use(a, createVerificationRouter(x))"],
        "noMatch": ["router.use('/a', b)"]
      }
    },
    {
      "id": "endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.$M($X, $$$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete)$" },
        "X": { "regex": "^['\"`]/" }
      },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["router.get('/me', a, b)"], "noMatch": ["map.get(key)"] }
    },
    {
      "id": "route-chain",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.route($X).$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["router.route('/a').post(x)"], "noMatch": ["router.get('/a', x)"] }
    },
    {
      "id": "route-chain2",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.route($X).$M1($$$A).$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["router.route('/a').post(x).get(y)"], "noMatch": ["router.get('/a', x)"] }
    },
    {
      "id": "mongoose-model",
      "language": "typescript",
      "files": ["src/**/model.ts", "src/**/*-model.ts"],
      "rule": { "pattern": "model($N, $S)" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["model('User', schema)"], "noMatch": ["foo('User')"] }
    }
  ]
}
