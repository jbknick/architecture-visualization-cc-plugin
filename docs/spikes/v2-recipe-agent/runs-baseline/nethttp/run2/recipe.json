{
  "name": "nethttp",
  "frameworks": [{ "name": "net/http", "evidence": "http.NewServeMux" }],
  "when": { "imports": ["net/http"] },
  "helpers": ["resolve-names"],
  "rules": [
    {
      "id": "method-pattern",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.HandleFunc($P, $H)" },
      "constraints": { "P": { "regex": "^\"(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS) " } },
      "emit": {
        "kind": "endpoint",
        "method": "$P",
        "path": "$P",
        "handler": "$H",
        "splitMethod": true,
        "standalone": true
      },
      "examples": {
        "match": ["func f() { r.HandleFunc(\"GET /x/{id}\", h) }"],
        "noMatch": ["func f() { r.HandleFunc(\"/x\", h) }"]
      }
    },
    {
      "id": "plain-pattern",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.HandleFunc($P, $H)" },
      "constraints": { "P": { "regex": "^\"[^A-Z ]" } },
      "emit": { "kind": "endpoint", "method": "=ALL", "path": "$P", "handler": "$H", "standalone": true },
      "examples": {
        "match": ["func f() { r.HandleFunc(\"/x\", h) }"],
        "noMatch": ["func f() { r.HandleFunc(\"GET /x\", h) }"]
      }
    }
  ]
}
