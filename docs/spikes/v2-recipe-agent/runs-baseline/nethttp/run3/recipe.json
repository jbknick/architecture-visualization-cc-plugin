{
  "name": "nethttp",
  "frameworks": [{ "name": "net/http", "evidence": "http.NewServeMux and HandleFunc" }],
  "when": { "imports": ["net/http"] },
  "helpers": ["resolve-names", "const-strings"],
  "rules": [
    {
      "id": "handle-method",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.HandleFunc($P, $H)" },
      "constraints": { "P": { "regex": "^\"(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD) " } },
      "emit": {
        "kind": "endpoint",
        "standalone": true,
        "method": "=ALL",
        "path": "$P",
        "handler": "$H",
        "splitMethod": true
      },
      "examples": {
        "match": ["func f() { r.HandleFunc(\"GET /x/{id}\", h) }"],
        "noMatch": ["func f() { r.HandleFunc(\"/x\", h) }"]
      }
    },
    {
      "id": "handle-plain",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.HandleFunc($P, $H)" },
      "constraints": { "P": { "regex": "^\"[^ ]*\"$" } },
      "emit": { "kind": "endpoint", "standalone": true, "method": "=ALL", "path": "$P", "handler": "$H" },
      "examples": {
        "match": ["func f() { r.HandleFunc(\"/x\", h) }"],
        "noMatch": ["func f() { r.HandleFunc(\"GET /x\", h) }"]
      }
    }
  ]
}
