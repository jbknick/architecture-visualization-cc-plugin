{
  "name": "next-boilerplate",
  "frameworks": [
    { "name": "nextjs", "evidence": "app router" },
    { "name": "drizzle", "evidence": "pgTable" }
  ],
  "helpers": [],
  "rules": [
    {
      "id": "pages",
      "language": "text",
      "files": ["src/app/**/page.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^src/app/(.*)page\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\([^/]*\\)/", "with": "" }]
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": [] }
    },
    {
      "id": "route-handlers",
      "language": "typescript",
      "files": ["src/app/**/route.ts"],
      "rule": { "pattern": "export const $M = $$$A" },
      "constraints": { "M": { "regex": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "pathFromFile": {
          "pattern": "^src/app/(.*)/route\\.ts$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\([^/]*\\)/", "with": "" }]
        }
      },
      "examples": {
        "match": ["export const PUT = async (r: Request) => {}"],
        "noMatch": ["export const foo = 1"]
      }
    },
    {
      "id": "tables",
      "language": "typescript",
      "files": ["src/models/**/*.ts"],
      "rule": { "pattern": "pgTable($N, $$$A)" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["export const a = pgTable('counter', {})"], "noMatch": ["foo('x')"] }
    }
  ]
}
