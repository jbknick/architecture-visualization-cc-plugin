{
  "name": "fastify-prisma",
  "frameworks": [{ "name": "fastify", "evidence": "package.json dependency" }],
  "when": { "dependency": ["fastify"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "fastify-router",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["fastify({ logger: true })"], "noMatch": ["foo.fastify"] }
    },
    {
      "id": "fastify-register",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["server.register(userRouter, { prefix: '/api/user' })"],
        "noMatch": ["server.register(cors)"]
      }
    },
    {
      "id": "fastify-endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": {
        "any": [{ "pattern": "$R.$M($X, $H)" }, { "pattern": "$R.$M($X, $O, $H)" }]
      },
      "constraints": { "M": { "regex": "^(get|post|put|delete|patch|head|options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X", "handler": "$H" },
      "examples": {
        "match": ["fastify.post('/login', {}, h)", "server.get('/', (a, b) => {})"],
        "noMatch": ["map.set(k, v)"]
      }
    },
    {
      "id": "prisma-model",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "model\\s+(\\w+)\\s*\\{(?![^}]*@@map)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model Post {\n id Int\n}"], "noMatch": ["enum Role {"] }
    },
    {
      "id": "prisma-model-map",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "model\\s+\\w+\\s*\\{[^}]*@@map\\(\"(\\w+)\"\\)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": {
        "match": ["model User {\n id Int\n @@map(\"users\")\n}"],
        "noMatch": ["model Post {\n id Int\n}"]
      }
    }
  ]
}
