{
  "name": "fastify-typescript",
  "frameworks": [
    { "name": "fastify", "evidence": "package.json dependency" },
    { "name": "prisma", "evidence": "prisma/schema.prisma" }
  ],
  "when": { "dependency": ["fastify"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "fastify-instance",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["fastify({ logger: true })"], "noMatch": ["foo({})"] }
    },
    {
      "id": "fastify-register",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": {
        "match": ["server.register(userRouter, { prefix: '/api/user' })"],
        "noMatch": ["server.register(cors)"]
      }
    },
    {
      "id": "fastify-endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": {
        "any": [
          { "pattern": "$R.$M($X, $A, $B)" },
          { "pattern": "$R.$M($X, $A)" },
          { "pattern": "$R.$M($X)" }
        ]
      },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|head|options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": {
        "match": ["const app = fastify(); app.post('/login', {}, handler)"],
        "noMatch": ["fastify.listen(3000)"]
      }
    },
    {
      "id": "prisma-mapped",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "@@map\\(\"([^\"]+)\"\\)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["@@map(\"users\")"], "noMatch": ["model User {"] }
    },
    {
      "id": "prisma-unmapped",
      "language": "text",
      "files": ["prisma/schema.prisma"],
      "rule": { "regex": "model\\s+(\\w+)\\s*\\{(?:(?!@@map)[^}])*\\}" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model Post {\n id Int\n}"], "noMatch": ["model User {\n @@map(\"users\")\n}"] }
    }
  ]
}
