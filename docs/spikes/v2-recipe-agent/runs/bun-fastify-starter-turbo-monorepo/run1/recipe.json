{
  "name": "fastify-kysely",
  "frameworks": [{ "name": "fastify", "evidence": "package.json" }],
  "when": { "dependency": ["fastify"] },
  "passthrough": ["withTypeProvider", "setValidatorCompiler"],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["apps/backend/src/server.ts"],
      "rule": { "pattern": "Fastify($$A)" },
      "emit": { "kind": "router" },
      "examples": { "match": ["Fastify({})"], "noMatch": ["foo({})"] }
    },
    {
      "id": "register-prefix",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C, { prefix: $X })" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": { "match": ["f.register(r, { prefix: \"/a\" })"], "noMatch": ["f.register(r)"] }
    },
    {
      "id": "register",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register($C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["f.register(r)"], "noMatch": ["f.register(r, {})"] }
    },
    {
      "id": "register-fp",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "pattern": "$P.register(fp($C))" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["f.register(fp(r))"], "noMatch": ["f.register(r)"] }
    },
    {
      "id": "endpoint",
      "language": "typescript",
      "files": ["apps/backend/src/**/*.ts"],
      "rule": { "any": [{ "pattern": "$R.$M($X, $H)" }, { "pattern": "$R.$M($X, $O, $H)" }] },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|head|options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["f.get(\"/\", h)", "f.post(\"/e\", {}, h)"], "noMatch": ["m.set(k, v)"] }
    },
    {
      "id": "tables",
      "language": "typescript",
      "files": ["apps/backend/src/db/types/index.ts"],
      "rule": {
        "kind": "property_signature",
        "inside": {
          "kind": "interface_body",
          "inside": { "kind": "interface_declaration", "has": { "field": "name", "regex": "^Database$" } }
        },
        "has": { "field": "name", "pattern": "$N" }
      },
      "emit": { "kind": "table", "name": "$N" },
      "examples": {
        "match": ["interface Database { users: UsersTable }"],
        "noMatch": ["interface Other { a: B }"]
      }
    }
  ]
}
