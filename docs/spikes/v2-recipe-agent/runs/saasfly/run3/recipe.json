{
  "name": "saasfly",
  "frameworks": [
    { "name": "nextjs", "evidence": "app router" },
    { "name": "prisma", "evidence": "schema.prisma" }
  ],
  "helpers": [],
  "rules": [
    {
      "id": "next-pages",
      "language": "text",
      "files": ["apps/nextjs/src/app/**/page.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs/src/app/(.*)page\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\([^/]*\\)/", "with": "" },
            { "regex": "\\[\\[?\\.\\.\\.[^/]*\\]\\]?", "with": "*" },
            { "regex": "(.)/$", "with": "$1" }
          ]
        }
      },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "next-route-exports",
      "language": "typescript",
      "files": ["apps/nextjs/src/app/**/route.ts"],
      "rule": { "pattern": { "context": "export { $H as $M }", "selector": "export_specifier" } },
      "constraints": { "M": { "regex": "^(GET|POST|PUT|PATCH|DELETE)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "pathFromFile": {
          "pattern": "^apps/nextjs/src/app/(.*)/route\\.ts$",
          "template": "/$1",
          "rewrite": [
            { "regex": "\\([^/]*\\)/", "with": "" },
            { "regex": "\\[\\[?\\.\\.\\.[^/]*\\]\\]?", "with": "*" }
          ]
        }
      },
      "examples": {
        "match": ["export { handler as GET, handler as POST };"],
        "noMatch": ["export { handler };"]
      }
    },
    {
      "id": "nitro-auth-proxy",
      "language": "text",
      "files": ["apps/auth-proxy/routes/[...auth].ts"],
      "rule": {},
      "emit": {
        "kind": "endpoint",
        "method": "=ALL",
        "pathFromFile": {
          "pattern": "^apps/auth-proxy/routes/(.*)\\.ts$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\[\\[?\\.\\.\\.[^/]*\\]\\]?", "with": "*" }]
        }
      },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "prisma-models",
      "language": "text",
      "files": ["**/*.prisma"],
      "rule": { "regex": "^model\\s+(\\w+)\\s*\\{" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["model User {\n id Int\n}"], "noMatch": ["enum X {\n}"] }
    }
  ]
}
