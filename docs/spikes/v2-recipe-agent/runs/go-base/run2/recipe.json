{
  "name": "go-base",
  "frameworks": [{ "name": "chi", "evidence": "go.mod" }],
  "when": { "imports": ["github.com/go-chi/chi/v5", "github.com/uptrace/bun"] },
  "helpers": ["resolve-names", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "chi.NewRouter()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["chi.NewRouter()"], "noMatch": ["chi.NewMux2()"] }
    },
    {
      "id": "mount",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$P.Mount($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["r.Mount(\"/a\", b)"], "noMatch": ["r.Get(\"/a\", b)"] }
    },
    {
      "id": "route-scope",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$P.Route($X, $C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X", "childIsScope": true },
      "examples": { "match": ["r.Route(\"/a\", func(r chi.Router) {})"], "noMatch": ["r.Get(\"/a\", b)"] }
    },
    {
      "id": "group-scope",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": { "context": "func _() { $P.Group($C) }", "selector": "call_expression" } },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "childIsScope": true },
      "examples": { "match": ["r.Group(func(r chi.Router) {})"], "noMatch": ["r.Get(\"/a\", b)"] }
    },
    {
      "id": "endpoint",
      "language": "go",
      "files": ["**/*.go"],
      "rule": { "pattern": "$R.$M($X, $H)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Delete|Patch|Head|Options)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X", "handler": "$H" },
      "examples": { "match": ["r.Get(\"/a\", h)"], "noMatch": ["r.Mount(\"/a\", h)"] }
    },
    {
      "id": "sql-tables",
      "language": "text",
      "files": ["database/migrations/*.go"],
      "rule": { "regex": "CREATE TABLE (\\w+)" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["CREATE TABLE accounts ("], "noMatch": ["DROP TABLE accounts"] }
    }
  ]
}
