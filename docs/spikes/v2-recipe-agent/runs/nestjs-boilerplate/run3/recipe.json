{
  "name": "nestjs-boilerplate",
  "frameworks": [{ "name": "nestjs", "evidence": "package.json dependency" }],
  "when": { "dependency": ["@nestjs/common"] },
  "helpers": [],
  "rules": [
    {
      "id": "nest-controller-endpoints",
      "language": "typescript",
      "files": ["src/**/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M($X)" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete|All)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "$X",
        "prefix": "=/api/v1",
        "ancestorPrefix": {
          "kind": "class_declaration",
          "rule": { "pattern": "Controller({ path: $P, version: $V })" },
          "capture": "$P"
        }
      },
      "examples": {
        "match": ["class A { @Get('x') foo() {} }"],
        "noMatch": ["class A { @Foo('x') foo() {} }"]
      }
    },
    {
      "id": "nest-controller-endpoints-root",
      "language": "typescript",
      "files": ["src/**/*.controller.ts", "!src/home/**"],
      "rule": { "kind": "decorator", "pattern": "@$M()" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete|All)$" } },
      "emit": {
        "kind": "endpoint",
        "method": "$M",
        "path": "=",
        "prefix": "=/api/v1",
        "ancestorPrefix": {
          "kind": "class_declaration",
          "rule": { "pattern": "Controller({ path: $P, version: $V })" },
          "capture": "$P"
        }
      },
      "examples": {
        "match": ["class A { @Get() foo() {} }"],
        "noMatch": ["class A { @Foo() foo() {} }"]
      }
    },
    {
      "id": "nest-home-controller",
      "language": "typescript",
      "files": ["src/home/*.controller.ts"],
      "rule": { "kind": "decorator", "pattern": "@$M()" },
      "constraints": { "M": { "regex": "^(Get|Post|Put|Patch|Delete|All)$" } },
      "emit": { "kind": "endpoint", "method": "$M", "path": "=/" },
      "examples": {
        "match": ["class A { @Get() foo() {} }"],
        "noMatch": ["class A { @Foo() foo() {} }"]
      }
    },
    {
      "id": "typeorm-entity",
      "language": "typescript",
      "files": ["src/**/*.entity.ts"],
      "rule": { "pattern": "@Entity({ name: $N })", "kind": "decorator" },
      "emit": { "kind": "table", "name": "$N" },
      "examples": {
        "match": ["@Entity({ name: 'role' }) class A {}"],
        "noMatch": ["@Column({ name: 'role' }) class A {}"]
      }
    },
    {
      "id": "mongoose-schema-class",
      "language": "typescript",
      "files": ["src/**/*.schema.ts"],
      "rule": {
        "kind": "class_declaration",
        "has": { "field": "name", "pattern": "$N" }
      },
      "emit": { "kind": "table", "name": "$N" },
      "examples": {
        "match": ["export class RoleSchema {}"],
        "noMatch": ["const a = 1;"]
      }
    }
  ]
}
