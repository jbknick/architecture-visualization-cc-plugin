{
  "name": "simplebank",
  "frameworks": [{ "name": "gin", "evidence": "go.mod" }],
  "when": { "imports": ["github.com/gin-gonic/gin"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "gin-router",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "gin.Default()" },
      "emit": { "kind": "router" },
      "examples": { "match": ["gin.Default()"], "noMatch": ["gin.New2()"] }
    },
    {
      "id": "gin-endpoint",
      "language": "go",
      "files": ["api/**/*.go"],
      "rule": { "pattern": "$R.$M($P, $H)" },
      "constraints": { "M": { "regex": "^(GET|POST|PUT|DELETE|PATCH)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$P", "handler": "$H" },
      "examples": { "match": ["router.POST(\"/users\", server.createUser)"], "noMatch": ["m.Get(\"/x\", h)"] }
    },
    {
      "id": "sql-tables",
      "language": "text",
      "files": ["doc/schema.sql"],
      "rule": { "regex": "CREATE TABLE \"?(\\w+)\"?" },
      "emit": { "kind": "table", "name": "#1" },
      "examples": { "match": ["CREATE TABLE \"users\" ("], "noMatch": ["CREATE INDEX x"] }
    }
  ]
}
