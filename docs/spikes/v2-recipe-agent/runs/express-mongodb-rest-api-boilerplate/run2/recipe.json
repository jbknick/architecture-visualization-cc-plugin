{
  "name": "express-mongoose",
  "frameworks": [{ "name": "express", "evidence": "package.json dependency" }],
  "when": { "dependency": ["express"] },
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "param-flow"],
  "rules": [
    {
      "id": "router",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": {
        "any": [{ "pattern": "Router()" }, { "pattern": "Router($$$A)" }, { "pattern": "express()" }]
      },
      "emit": { "kind": "router" },
      "examples": { "match": ["Router()", "express()"], "noMatch": ["foo()"] }
    },
    {
      "id": "mount-prefixed",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.use($X, $C)" },
      "constraints": { "X": { "kind": "string" } },
      "emit": { "kind": "mount", "parent": "$P", "child": "$C", "prefix": "$X" },
      "examples": { "match": ["router.use('/docs/', docs)"], "noMatch": ["router.use(a, b)"] }
    },
    {
      "id": "mount-plain",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$P.use($$$C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$$$C" },
      "examples": { "match": ["router.use(a, b)"], "noMatch": ["router.get('/x', h)"] }
    },
    {
      "id": "endpoint",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.$M($X, $$$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|all)$" },
        "X": { "kind": "string" }
      },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["app.get('/me', h)"], "noMatch": ["req.get(x)"] }
    },
    {
      "id": "endpoint-route-chain",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.route($X).$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|all)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["router.route('/a').post(h)"], "noMatch": ["router.get('/a', h)"] }
    },
    {
      "id": "endpoint-route-chain2",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "$R.route($X).$M1($$$H1).$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|all)$" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "method": "$M", "path": "$X" },
      "examples": { "match": ["router.route('/a').post(h).get(h)"], "noMatch": ["router.get('/a', h)"] }
    },
    {
      "id": "mongoose-model",
      "language": "typescript",
      "files": ["src/**/*.ts"],
      "rule": { "pattern": "model($N, $$$A)" },
      "constraints": { "N": { "kind": "string" } },
      "emit": { "kind": "table", "name": "$N" },
      "examples": { "match": ["model('User', schema)"], "noMatch": ["foo('User')"] }
    }
  ]
}
