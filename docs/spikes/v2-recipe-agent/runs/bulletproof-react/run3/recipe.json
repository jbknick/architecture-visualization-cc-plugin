{
  "name": "bulletproof-react",
  "frameworks": [
    { "name": "nextjs", "evidence": "apps/nextjs-* package.json" },
    { "name": "react-router", "evidence": "apps/react-vite router.tsx" }
  ],
  "helpers": [],
  "rules": [
    {
      "id": "next-app-pages",
      "language": "text",
      "files": ["apps/nextjs-app/src/app/**/page.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs-app/src/app/(.*)page\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "\\([^/]*\\)/", "with": "" }, { "regex": "(.)/$", "with": "$1" }]
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": [] }
    },
    {
      "id": "next-pages",
      "language": "text",
      "files": ["apps/nextjs-pages/src/pages/**/*.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs-pages/src/pages/((?:[^_/][^/]*/)*[^_/][^/]*)\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "/?index$", "with": "" }, { "regex": "^$", "with": "/" }]
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": [] }
    },
    {
      "id": "vite-routes",
      "language": "text",
      "files": [
        "apps/react-vite/src/app/routes/landing.tsx",
        "apps/react-vite/src/app/routes/not-found.tsx",
        "apps/react-vite/src/app/routes/auth/*.tsx",
        "apps/react-vite/src/app/routes/app/dashboard.tsx",
        "apps/react-vite/src/app/routes/app/users.tsx",
        "apps/react-vite/src/app/routes/app/profile.tsx",
        "apps/react-vite/src/app/routes/app/discussions/discussions.tsx",
        "apps/react-vite/src/app/routes/app/discussions/discussion.tsx"
      ],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/react-vite/src/app/routes/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [
            { "regex": "^/landing$", "with": "/" },
            { "regex": "^/not-found$", "with": "*" },
            { "regex": "^/app/dashboard$", "with": "/app" },
            { "regex": "^/app/discussions/discussions$", "with": "/app/discussions" },
            { "regex": "^/app/discussions/discussion$", "with": "/app/discussions/:discussionId" }
          ]
        }
      },
      "examples": { "match": ["export default function P() {}"], "noMatch": [] }
    }
  ]
}
