{
  "name": "bulletproof-react",
  "frameworks": [
    { "name": "nextjs", "evidence": "apps/nextjs-*" },
    { "name": "react-router", "evidence": "apps/react-vite" }
  ],
  "helpers": [],
  "rules": [
    {
      "id": "next-app",
      "language": "text",
      "files": ["apps/nextjs-app/src/app/**/page.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": { "pattern": "^apps/nextjs-app/src/app/(.*?)/?page\\.tsx$", "template": "/$1" }
      },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "next-pages",
      "language": "text",
      "files": [
        "apps/nextjs-pages/src/pages/index.tsx",
        "apps/nextjs-pages/src/pages/app/**/*.tsx",
        "apps/nextjs-pages/src/pages/auth/**/*.tsx",
        "apps/nextjs-pages/src/pages/public/**/*.tsx"
      ],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": {
          "pattern": "^apps/nextjs-pages/src/pages/(.*)\\.tsx$",
          "template": "/$1",
          "rewrite": [{ "regex": "/?index$", "with": "" }]
        }
      },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-landing",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/landing.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-register",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/auth/register.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/auth/register" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-login",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/auth/login.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/auth/login" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-dashboard",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/dashboard.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/app" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-discussions",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/discussions/discussions.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/app/discussions" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-discussion",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/discussions/discussion.tsx"],
      "rule": {},
      "emit": {
        "kind": "route",
        "pathFromFile": { "pattern": "^(.*)$", "template": "/app/discussions/:discussionId" }
      },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-users",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/users.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/app/users" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-profile",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/app/profile.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "/app/profile" } },
      "examples": { "match": [""], "noMatch": [] }
    },
    {
      "id": "vite-notfound",
      "language": "text",
      "files": ["apps/react-vite/src/app/routes/not-found.tsx"],
      "rule": {},
      "emit": { "kind": "route", "pathFromFile": { "pattern": "^(.*)$", "template": "*" } },
      "examples": { "match": [""], "noMatch": [] }
    }
  ]
}
