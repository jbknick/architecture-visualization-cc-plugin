{
  "name": "hono",
  "frameworks": [{ "name": "hono", "evidence": "package.json dependency; new Hono() in server code" }],
  "when": { "dependency": ["hono"] },
  "passthrough": ["get", "post", "put", "patch", "delete", "options", "all", "on", "use", "route"],
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return"],
  "rules": [
    {
      "id": "app",
      "language": "typescript",
      "rule": { "pattern": "new Hono($$$A)" },
      "emit": { "kind": "router" }
    },
    {
      "id": "base-path",
      "language": "typescript",
      "rule": { "pattern": "$X.basePath($B)" },
      "emit": { "kind": "router", "base": "$B" }
    },
    {
      "id": "route",
      "language": "typescript",
      "rule": { "pattern": "$APP.$M($P, $$$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|options|all)$" },
        "P": { "any": [{ "kind": "string" }, { "kind": "template_string" }, { "kind": "identifier" }] }
      },
      "emit": { "kind": "endpoint", "receiver": "$APP", "method": "$M", "path": "$P", "handler": "$$$H" }
    },
    {
      "id": "route-chained-no-path",
      "language": "typescript",
      "rule": { "pattern": "$APP.$M($H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|options|all)$" },
        "H": { "not": { "kind": "string" } }
      },
      "emit": {
        "kind": "endpoint",
        "receiver": "$APP",
        "method": "$M",
        "handler": "$H",
        "pathFromChain": true
      }
    },
    {
      "id": "route-on",
      "language": "typescript",
      "rule": { "pattern": "$APP.on($MS, $P, $$$H)" },
      "emit": { "kind": "endpoint", "receiver": "$APP", "method": "$MS", "path": "$P", "handler": "$$$H" }
    },
    {
      "id": "mount",
      "language": "typescript",
      "rule": { "pattern": "$PARENT.route($P, $CHILD)" },
      "emit": { "kind": "mount", "parent": "$PARENT", "prefix": "$P", "child": "$CHILD" }
    },
    {
      "id": "middleware",
      "language": "typescript",
      "rule": { "pattern": "$APP.use($P, $$$H)" },
      "constraints": { "P": { "any": [{ "kind": "string" }, { "kind": "template_string" }] } },
      "emit": { "kind": "middleware", "receiver": "$APP", "path": "$P", "handler": "$$$H" }
    }
  ]
}
