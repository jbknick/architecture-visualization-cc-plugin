{
  "version": 1,
  "dependencies": [
    {
      "name": "@mikro-orm/core",
      "role": "data-access",
      "note": "ORM: @Entity classes, EntityRepository<T>, EntityManager"
    },
    {
      "name": "@mikro-orm/mongodb",
      "role": "data-access",
      "note": "ORM driver: tables are collections named by the entity class"
    },
    { "name": "express", "role": "framework", "note": "HTTP framework; routes are not read by this recipe" }
  ],
  "helpers": ["resolve-names", "const-strings", "model-naming", "method-classes"],
  "models": {
    "explicit": {
      "books": "Book",
      "author": "Author",
      "authors": "Author",
      "publisher": "Publisher",
      "tags": "BookTag"
    }
  },
  "methods": {
    "read": ["find", "findOne", "findOneOrFail", "findAll", "findAndCount", "count", "findByCursor"],
    "write": [
      "create",
      "persist",
      "persistAndFlush",
      "remove",
      "removeAndFlush",
      "nativeInsert",
      "nativeUpdate",
      "nativeDelete",
      "upsert",
      "insert",
      "insertMany"
    ]
  },
  "rules": [
    {
      "id": "entity-default",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "kind": "decorator", "pattern": "@Entity()" },
      "emit": { "kind": "table", "name": "@class", "model": "@class" },
      "examples": {
        "match": ["@Entity()\nexport class Book {}"],
        "noMatch": ["@Injectable()\nexport class Book {}"]
      }
    },
    {
      "id": "entity-named",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "kind": "decorator", "pattern": "@Entity({ tableName: $N })" },
      "emit": { "kind": "table", "name": "$N", "model": "@class" },
      "examples": {
        "match": ["@Entity({ tableName: 'books' })\nexport class Book {}"],
        "noMatch": ["@Entity()\nexport class Book {}"]
      }
    },
    {
      "id": "populate-read",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "pattern": "{ populate: [$$$M] }" },
      "emit": { "kind": "read", "model": "$$$M" },
      "examples": {
        "match": ["DI.authors.findAll({ populate: ['books'] });"],
        "noMatch": ["DI.authors.findAll({ orderBy: {} });"]
      }
    },
    {
      "id": "em-read",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "pattern": "$E.$M($MODEL, $$$A)" },
      "constraints": { "MODEL": { "kind": "identifier" } },
      "emit": { "kind": "read", "model": "$MODEL", "method": "$M" },
      "examples": {
        "match": ["em.findOne(Book, id);"],
        "noMatch": ["em.findOne(Book);", "em.findOne(\"Book\", id);"]
      }
    },
    {
      "id": "em-write",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "pattern": "$E.$M($MODEL, $$$A)" },
      "constraints": { "MODEL": { "kind": "identifier" } },
      "emit": { "kind": "write", "model": "$MODEL", "method": "$M" },
      "examples": {
        "match": ["DI.em.create(Book, body);"],
        "noMatch": ["em.create(Book);", "em.create(\"Book\", body);"]
      }
    },
    {
      "id": "repository-read",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "pattern": "$R.$M($$$A)" },
      "constraints": { "R": { "kind": "member_expression" } },
      "emit": {
        "kind": "read",
        "receiver": "$R",
        "method": "$M",
        "receiverDecl": ["\\b{prop}\\s*:\\s*EntityRepository<(\\w+)>"]
      },
      "examples": {
        "match": ["DI.authors.findAll({});"],
        "noMatch": ["authors.findAll({});", "findAll({});"]
      }
    },
    {
      "id": "repository-write",
      "language": "typescript",
      "when": { "dependency": ["@mikro-orm/core", "@mikro-orm/mongodb"] },
      "rule": { "pattern": "$R.$M($$$A)" },
      "constraints": { "R": { "kind": "member_expression" } },
      "emit": {
        "kind": "write",
        "receiver": "$R",
        "method": "$M",
        "receiverDecl": ["\\b{prop}\\s*:\\s*EntityRepository<(\\w+)>"]
      },
      "examples": {
        "match": ["DI.authors.create(body);"],
        "noMatch": ["authors.create(body);", "create(body);"]
      }
    }
  ]
}
