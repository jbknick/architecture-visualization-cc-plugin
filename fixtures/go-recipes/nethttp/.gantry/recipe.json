{
  "version": 1,
  "helpers": ["resolve-names", "const-strings", "mount-graph", "param-flow"],
  "rules": [
    {
      "id": "mux",
      "language": "go",
      "rule": { "pattern": "http.NewServeMux()" },
      "emit": { "kind": "router" },
      "examples": {
        "match": ["mux := http.NewServeMux()"],
        "noMatch": ["req, _ := http.NewRequest(\"GET\", \"/\", nil)"]
      }
    },
    {
      "id": "mux-handle-func",
      "language": "go",
      "uncalled": true,
      "rule": { "pattern": "$R.HandleFunc($P, $H)" },
      "constraints": { "P": { "regex": "^\"(?:[A-Z]+ )?/" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "methodInPath": true, "path": "$P", "handler": "$H" },
      "examples": {
        "match": ["mux.HandleFunc(\"GET /users/{id}\", get)", "mux.HandleFunc(\"/\", index)"],
        "noMatch": ["mux.HandleFunc(\"shop.example.com/\", host)", "mux.Get(\"/x\", h)"]
      }
    },
    {
      "id": "mux-handle",
      "language": "go",
      "uncalled": true,
      "rule": { "pattern": "$R.Handle($P, $H)" },
      "constraints": { "P": { "regex": "^\"(?:[A-Z]+ )?/" } },
      "emit": { "kind": "endpoint", "receiver": "$R", "methodInPath": true, "path": "$P", "handler": "$H" },
      "examples": {
        "match": ["mux.Handle(\"DELETE /users/{id}\", h)"],
        "noMatch": ["mux.Handle(\"example.com/\", h)"]
      }
    }
  ]
}
