{
  "version": 1,
  "helpers": ["resolve-names", "const-strings", "mount-graph", "fs-routes"],
  "passthrough": ["basePath", "get", "post", "put", "patch", "delete", "options", "all", "on", "use", "route"],
  "rules": [
    {
      "id": "hono-app",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "new Hono($$$A)" },
      "emit": { "kind": "router", "data": { "adapter": "hono" } },
      "examples": {
        "match": ["const app = new Hono();", "export const users = new Hono().basePath(\"/v1\");"],
        "noMatch": ["const app = new Elysia();", "const m = new Map();"]
      }
    },
    {
      "id": "hono-base-path",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$X.basePath($B)" },
      "emit": { "kind": "router", "base": "$B", "data": { "adapter": "hono" } },
      "examples": {
        "match": ["const users = new Hono().basePath(\"/v1\");"],
        "noMatch": ["app.get(\"/v1\", handler);"]
      }
    },
    {
      "id": "hono-route",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$APP.$M($P, $$$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|options|all)$" },
        "P": { "any": [{ "kind": "string" }, { "kind": "template_string" }, { "kind": "identifier" }] }
      },
      "emit": {
        "kind": "endpoint",
        "receiver": "$APP",
        "method": "$M",
        "path": "$P",
        "handler": "$$$H",
        "pathFromChain": true,
        "data": { "adapter": "hono" }
      },
      "examples": {
        "match": ["app.get(\"/health\", (c) => c.text(\"ok\"));", "app.post(HEALTH_PATH, auth, handler);"],
        "noMatch": ["app.use(\"/x\", mw);", "cache.has(\"k\");"]
      }
    },
    {
      "id": "hono-route-chained",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$APP.$M($H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|options|all)$" },
        "H": { "not": { "any": [{ "kind": "string" }, { "kind": "template_string" }] } }
      },
      "emit": {
        "kind": "endpoint",
        "receiver": "$APP",
        "method": "$M",
        "handler": "$H",
        "pathFromChain": true,
        "data": { "adapter": "hono" }
      },
      "examples": {
        "match": ["new Hono().get(\"/\", list).post(create);"],
        "noMatch": ["app.use(logger());"]
      }
    },
    {
      "id": "hono-route-on",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$APP.on($MS, $P, $$$H)" },
      "emit": {
        "kind": "endpoint",
        "receiver": "$APP",
        "method": "$MS",
        "path": "$P",
        "handler": "$$$H",
        "data": { "adapter": "hono" }
      },
      "examples": {
        "match": ["posts.on([\"PUT\", \"PATCH\"], \"/posts/:id\", async (c) => c.json({}));"],
        "noMatch": ["posts.get(\"/posts/:id\", showPost);"]
      }
    },
    {
      "id": "hono-mount",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$PARENT.route($P, $CHILD)" },
      "emit": {
        "kind": "mount",
        "parent": "$PARENT",
        "prefix": "$P",
        "child": "$CHILD",
        "data": { "adapter": "hono" }
      },
      "examples": {
        "match": ["app.route(\"/api\", posts);"],
        "noMatch": ["app.get(\"/api\", posts);"]
      }
    },
    {
      "id": "hono-middleware",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$APP.use($P, $$$H)" },
      "constraints": { "P": { "any": [{ "kind": "string" }, { "kind": "template_string" }] } },
      "emit": { "kind": "middleware", "receiver": "$APP", "path": "$P", "handler": "$$$H", "data": { "adapter": "hono" } },
      "examples": {
        "match": ["app.use(\"*\", cors());"],
        "noMatch": ["app.use(cors());"]
      }
    },
    {
      "id": "hono-middleware-any-path",
      "language": "typescript",
      "when": { "dependency": ["hono"] },
      "rule": { "pattern": "$APP.use($H)" },
      "emit": { "kind": "middleware", "receiver": "$APP", "handler": "$H", "data": { "adapter": "hono" } },
      "examples": {
        "match": ["app.use(cors());"],
        "noMatch": ["app.use(\"*\", cors());"]
      }
    },
    {
      "id": "tanstack-file-route",
      "language": "typescript",
      "when": { "dependency": ["@tanstack/react-router", "@tanstack/react-start"] },
      "rule": { "pattern": "createFileRoute($ID)($OPTS)" },
      "emit": { "kind": "fileRoute", "convention": "tanstack-router", "id": "$ID", "options": "$OPTS" },
      "examples": {
        "match": ["export const Route = createFileRoute(\"/posts/$postId\")({ component: PostPage });"],
        "noMatch": ["const r = createRootRoute({ component: Root });"]
      }
    },
    {
      "id": "tanstack-root-route",
      "language": "typescript",
      "when": { "dependency": ["@tanstack/react-router", "@tanstack/react-start"] },
      "rule": { "pattern": "createRootRoute($OPTS)" },
      "emit": { "kind": "fileRoute", "convention": "tanstack-router", "options": "$OPTS", "root": true },
      "examples": {
        "match": ["export const Route = createRootRoute({ component: RootLayout });"],
        "noMatch": ["export const Route = createFileRoute(\"/\")({});"]
      }
    },
    {
      "id": "tanstack-root-route-with-context",
      "language": "typescript",
      "when": { "dependency": ["@tanstack/react-router", "@tanstack/react-start"] },
      "rule": { "pattern": "createRootRouteWithContext<$T>()($OPTS)" },
      "emit": { "kind": "fileRoute", "convention": "tanstack-router", "options": "$OPTS", "root": true },
      "examples": {
        "match": ["export const Route = createRootRouteWithContext<Ctx>()({ component: RootLayout });"],
        "noMatch": ["export const Route = createRootRoute({ component: RootLayout });"]
      }
    },
    {
      "id": "drizzle-table-sqlite",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": {
        "all": [
          { "pattern": "sqliteTable($N, $$$A)" },
          {
            "inside": {
              "kind": "variable_declarator",
              "inside": {
                "kind": "lexical_declaration",
                "inside": { "any": [{ "kind": "program" }, { "kind": "export_statement", "inside": { "kind": "program" } }] }
              }
            }
          }
        ]
      },
      "constraints": { "N": { "kind": "string" } },
      "emit": {
        "kind": "table",
        "name": "$N",
        "binding": true,
        "data": {
          "adapter": "drizzle",
          "name": "@name",
          "exportName": "@exportName",
          "symbol": "@symbol",
          "dialect": "sqlite",
          "columns": { "keysOf": "$$$A" },
          "file": "@file",
          "line": "@line"
        }
      },
      "examples": {
        "match": ["export const users = sqliteTable(\"users\", { id: text(\"id\") });"],
        "noMatch": ["function f() { const t = sqliteTable(\"users\", {}); }", "export const t = pgTable(\"t\", {});"]
      }
    },
    {
      "id": "drizzle-table-pg",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": {
        "all": [
          { "pattern": "pgTable($N, $$$A)" },
          {
            "inside": {
              "kind": "variable_declarator",
              "inside": {
                "kind": "lexical_declaration",
                "inside": { "any": [{ "kind": "program" }, { "kind": "export_statement", "inside": { "kind": "program" } }] }
              }
            }
          }
        ]
      },
      "constraints": { "N": { "kind": "string" } },
      "emit": {
        "kind": "table",
        "name": "$N",
        "binding": true,
        "data": {
          "adapter": "drizzle",
          "name": "@name",
          "exportName": "@exportName",
          "symbol": "@symbol",
          "dialect": "pg",
          "columns": { "keysOf": "$$$A" },
          "file": "@file",
          "line": "@line"
        }
      },
      "examples": {
        "match": ["export const users = pgTable(\"users\", { id: text(\"id\") });"],
        "noMatch": ["function f() { const t = pgTable(\"users\", {}); }", "export const t = sqliteTable(\"t\", {});"]
      }
    },
    {
      "id": "drizzle-table-mysql",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"] },
      "rule": {
        "all": [
          { "pattern": "mysqlTable($N, $$$A)" },
          {
            "inside": {
              "kind": "variable_declarator",
              "inside": {
                "kind": "lexical_declaration",
                "inside": { "any": [{ "kind": "program" }, { "kind": "export_statement", "inside": { "kind": "program" } }] }
              }
            }
          }
        ]
      },
      "constraints": { "N": { "kind": "string" } },
      "emit": {
        "kind": "table",
        "name": "$N",
        "binding": true,
        "data": {
          "adapter": "drizzle",
          "name": "@name",
          "exportName": "@exportName",
          "symbol": "@symbol",
          "dialect": "mysql",
          "columns": { "keysOf": "$$$A" },
          "file": "@file",
          "line": "@line"
        }
      },
      "examples": {
        "match": ["export const users = mysqlTable(\"users\", { id: text(\"id\") });"],
        "noMatch": ["function f() { const t = mysqlTable(\"users\", {}); }", "export const t = pgTable(\"t\", {});"]
      }
    },
    {
      "id": "drizzle-select-from",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"], "viaWorkspaces": true },
      "rule": { "pattern": "$S.from($T)" },
      "constraints": { "S": { "kind": "call_expression" } },
      "emit": { "kind": "read", "table": "$T" },
      "examples": {
        "match": ["db.select().from(posts);"],
        "noMatch": ["Array.from(posts);"]
      }
    },
    {
      "id": "drizzle-join",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"], "viaWorkspaces": true },
      "rule": { "pattern": "$S.$J($T, $$$A)" },
      "constraints": {
        "J": { "regex": "^(leftJoin|rightJoin|innerJoin|fullJoin)$" },
        "S": { "kind": "call_expression" }
      },
      "emit": { "kind": "read", "table": "$T" },
      "examples": {
        "match": ["db.select().from(posts).innerJoin(users, eq(posts.authorId, users.id));"],
        "noMatch": ["db.select().from(posts).where(eq(posts.id, 1));"]
      }
    },
    {
      "id": "drizzle-count",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"], "viaWorkspaces": true },
      "rule": { "any": [{ "pattern": "$D.$count($T)" }, { "pattern": "$D.$count($T, $$$A)" }] },
      "emit": { "kind": "read", "table": "$T" },
      "examples": {
        "match": ["db.$count(users);", "db.$count(users, eq(users.id, 1));"],
        "noMatch": ["db.count(users);"]
      }
    },
    {
      "id": "drizzle-relational-query",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"], "viaWorkspaces": true },
      "rule": { "pattern": "$D.$Q.$K.$M($$$A)" },
      "constraints": {
        "Q": { "regex": "^(query|_query)$" },
        "M": { "regex": "^(findMany|findFirst)$" }
      },
      "emit": { "kind": "read", "model": "$K" },
      "examples": {
        "match": ["db.query.posts.findMany({ limit: 20 });"],
        "noMatch": ["db.query.posts.count();", "db.posts.findMany();"]
      }
    },
    {
      "id": "drizzle-write",
      "language": "typescript",
      "when": { "dependency": ["drizzle-orm"], "viaWorkspaces": true },
      "rule": { "any": [{ "pattern": "$D.$M($T)" }, { "pattern": "$D.$M($T, $$$A)" }] },
      "constraints": { "M": { "regex": "^(insert|update|delete)$" } },
      "emit": { "kind": "write", "table": "$T" },
      "examples": {
        "match": ["db.insert(posts);", "tx.update(schema.users);", "db.delete(posts);"],
        "noMatch": ["db.select(posts);"]
      }
    }
  ],
  "tablePassthrough": ["alias"]
}
