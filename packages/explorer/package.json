{
  "name": "@gantry/explorer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run --config web/vitest.config.ts",
    "mock": "tsx web/mock/server.ts",
    "e2e": "pnpm build:web && playwright test --config web/playwright.config.ts",
    "perf": "pnpm build:web && playwright test --config web/playwright.perf.config.ts"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.2",
    "@gantry/core": "workspace:*",
    "elkjs": "^0.12.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sigma": "^4.0.6",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
