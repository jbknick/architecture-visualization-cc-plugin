{
  "name": "@gantry/explorer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run --config web/vitest.config.ts",
    "mock": "tsx web/mock/server.ts",
    "e2e": "pnpm build:web && playwright test --config web/playwright.config.ts"
  },
  "dependencies": {
    "@gantry/core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
