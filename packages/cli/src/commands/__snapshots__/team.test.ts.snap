// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > lists the four subcommands > link 1`] = `
"Usage: gantry team link [options]

Say which server and organisation this repo belongs to

Options:
  --server <url>  the team server
  --org <slug>    the organisation slug
  -h, --help      display help for command
"
`;

exports[`help > lists the four subcommands > login 1`] = `
"Usage: gantry team login [options]

Sign in to a team server with a code

Options:
  --server <url>  the team server (default: GANTRY_SERVER, then team.server)
  -h, --help      display help for command
"
`;

exports[`help > lists the four subcommands > logout 1`] = `
"Usage: gantry team logout [options]

Remove the stored sign-in for a server

Options:
  --server <url>  the team server (default: GANTRY_SERVER, then team.server)
  -h, --help      display help for command
"
`;

exports[`help > lists the four subcommands > status 1`] = `
"Usage: gantry team status [options]

Show the server, organisation, user and repo, and whether the server answers

Options:
  --json      print one JSON line
  -h, --help  display help for command
"
`;
