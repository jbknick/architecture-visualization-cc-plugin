// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > lists the subcommands > link 1`] = `
"Usage: gantry team link [options]

Say which server and organization this repo belongs to

Options:
  --server <url>  the team server
  --org <slug>    the organization slug
  -h, --help      display help for command
"
`;

exports[`help > lists the subcommands > login 1`] = `
"Usage: gantry team login [options]

Sign in to a team server with a code

Options:
  --server <url>  the team server (default: GANTRY_SERVER, then team.server)
  -h, --help      display help for command
"
`;

exports[`help > lists the subcommands > logout 1`] = `
"Usage: gantry team logout [options]

Remove the stored sign-in for a server

Options:
  --server <url>  the team server (default: GANTRY_SERVER, then team.server)
  -h, --help      display help for command
"
`;

exports[`help > lists the subcommands > status 1`] = `
"Usage: gantry team status [options]

Show the server, organization, user and repo, whether the server answers, and
the team cache

Options:
  --json      print one JSON line
  --pull      pull team state from the server first
  -h, --help  display help for command
"
`;
