{
 "version":1,
 "helpers":["resolve-names","const-strings","mount-graph","model-naming"],
 "passthrough":[],
 "models":{"explicit":{"user":"users","post":"Post"}},
 "methods":{"read":["findUnique","findFirst","findMany","count"],"write":["create","update","delete","upsert","createMany","updateMany","deleteMany"]},
 "rules":[
 {"id":"fastify-instance","language":"typescript","when":{"dependency":["fastify"]},
  "rule":{"pattern":"fastify($$$)"},"emit":{"kind":"router"},
  "examples":{"match":["const s = fastify({})"],"noMatch":["other({})"]}},
 {"id":"fastify-plugin-param","language":"typescript","when":{"dependency":["fastify"]},
  "rule":{"kind":"required_parameter","has":{"kind":"type_annotation","regex":"FastifyInstance"}},"emit":{"kind":"router"},
  "examples":{"match":["function r(fastify: FastifyInstance) { }"],"noMatch":["function r(x: number) { }"]}},
 {"id":"fastify-register","language":"typescript","when":{"dependency":["fastify"]},
  "rule":{"pattern":"$P.register($C, { prefix: $PRE })"},"emit":{"kind":"mount","parent":"$P","child":"$C","prefix":"$PRE","childIsScope":true},
  "examples":{"match":["server.register(a, { prefix: '/x' })"],"noMatch":["server.register(a)"]}},
 {"id":"fastify-endpoint","language":"typescript","when":{"dependency":["fastify"]},
  "rule":{"pattern":"$R.$M($PATH, $$$H)"},
  "constraints":{"M":{"regex":"^(get|post|put|delete|patch|all|head|options)$"},"PATH":{"kind":"string"}},
  "emit":{"kind":"endpoint","receiver":"$R","method":"$M","path":"$PATH","handler":"$$$H"},
  "examples":{"match":["server.get('/h', async () => {})"],"noMatch":["server.listen({})","map.get(k, 1)"]}},
 {"id":"prisma-schema","language":"text","files":["prisma/schema.prisma"],
  "rule":{"regex":"^model\\s+(\\w+)\\s*\\{[^}]*?(?:@@map\\(\"(\\w+)\"\\))?[^}]*\\}"},
  "emit":{"kind":"table","name":["$2","$1"],"model":"$1"},
  "examples":{"match":["model A {\n id Int\n}"],"noMatch":["enum R {\n A\n}"]}},
 {"id":"prisma-read","language":"typescript","when":{"dependency":["@prisma/client"]},
  "rule":{"pattern":"prisma.$M.$METH($$$)"},"emit":{"kind":"read","model":"$M","method":"$METH"},
  "examples":{"match":["prisma.user.findUnique({})"],"noMatch":["foo.user.findUnique({})"]}},
 {"id":"prisma-write","language":"typescript","when":{"dependency":["@prisma/client"]},
  "rule":{"pattern":"prisma.$M.$METH($$$)"},"emit":{"kind":"write","model":"$M","method":"$METH"},
  "examples":{"match":["prisma.post.create({})"],"noMatch":["foo.post.create({})"]}}
 ]}
