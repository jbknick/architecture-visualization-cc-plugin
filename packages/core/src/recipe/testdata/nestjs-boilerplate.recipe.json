{
  "version": 1,
  "helpers": ["text-rules"],
  "rules": [
    {
      "id": "typeorm-entity",
      "language": "text",
      "files": ["src/**/*.entity.ts"],
      "rule": { "regex": "@Entity\\(\\{\\s*name:\\s*'(\\w+)'" },
      "emit": { "kind": "table", "name": "$1" },
      "examples": {
        "match": ["@Entity({\n  name: 'role',\n})\nexport class A {}"],
        "noMatch": ["export class A {}"]
      }
    }
  ]
}
