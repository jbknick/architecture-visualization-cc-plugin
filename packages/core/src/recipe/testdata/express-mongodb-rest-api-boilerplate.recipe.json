{
  "version": 1,
  "helpers": ["resolve-names", "const-strings", "mount-graph", "call-return", "method-classes"],
  "methods": {
    "read": [
      "find",
      "findOne",
      "findById",
      "countDocuments",
      "estimatedDocumentCount",
      "exists",
      "aggregate",
      "distinct"
    ],
    "write": [
      "create",
      "insertMany",
      "updateOne",
      "updateMany",
      "replaceOne",
      "findOneAndUpdate",
      "findByIdAndUpdate",
      "findOneAndDelete",
      "findByIdAndDelete",
      "findOneAndReplace",
      "deleteOne",
      "deleteMany",
      "bulkWrite",
      "save"
    ]
  },
  "passthrough": ["use", "get", "post", "put", "patch", "delete", "all", "options", "head", "route"],
  "rules": [
    {
      "id": "express-app",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "express()" },
      "emit": { "kind": "router", "data": { "adapter": "express" } },
      "examples": {
        "match": ["const app = express();"],
        "noMatch": ["const app = fastify();", "const router = express.Router();"]
      }
    },
    {
      "id": "express-router",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "any": [{ "pattern": "Router($$$A)" }, { "pattern": "express.Router($$$A)" }] },
      "emit": { "kind": "router", "data": { "adapter": "express" } },
      "examples": {
        "match": ["const router = Router();", "const router = express.Router({ mergeParams: true });"],
        "noMatch": ["const route = new Route();"]
      }
    },
    {
      "id": "express-mount-at",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "$P.use($X, $$$C)" },
      "constraints": { "X": { "any": [{ "kind": "string" }, { "kind": "template_string" }] } },
      "emit": {
        "kind": "mount",
        "parent": "$P",
        "prefix": "$X",
        "child": "$$$C",
        "data": { "adapter": "express" }
      },
      "examples": {
        "match": ["app.use(\"/api\", apiRouter);"],
        "noMatch": ["app.use(apiRouter);"]
      }
    },
    {
      "id": "express-mount",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "$P.use($$$C)" },
      "emit": { "kind": "mount", "parent": "$P", "child": "$$$C", "data": { "adapter": "express" } },
      "examples": {
        "match": ["router.use(createAuthRouter(limit), createUserRouter());"],
        "noMatch": ["router.get(\"/x\", handler);"]
      }
    },
    {
      "id": "express-route-of",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "$R.route($P).$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|all|options|head)$" } },
      "emit": {
        "kind": "endpoint",
        "receiver": "$R",
        "method": "$M",
        "path": "$P",
        "handler": "$$$H",
        "data": { "adapter": "express" }
      },
      "examples": {
        "match": ["router.route(\"/sign-out\").post(guard, signOut);"],
        "noMatch": ["router.post(\"/sign-out\", signOut);"]
      }
    },
    {
      "id": "express-route-of-next",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "$R.$M($$$H)" },
      "constraints": { "M": { "regex": "^(get|post|put|patch|delete|all|options|head)$" } },
      "emit": {
        "kind": "endpoint",
        "receiver": "$R",
        "method": "$M",
        "handler": "$$$H",
        "pathFromChain": true,
        "data": { "adapter": "express" }
      },
      "examples": {
        "match": ["router.route(\"/sign-out\").post(guard, signOut).get(guard, signOut);"],
        "noMatch": ["router.use(guard);"]
      }
    },
    {
      "id": "express-route",
      "language": "typescript",
      "when": { "dependency": ["express"] },
      "rule": { "pattern": "$R.$M($P, $$$H)" },
      "constraints": {
        "M": { "regex": "^(get|post|put|patch|delete|all|options|head)$" },
        "P": { "any": [{ "kind": "string" }, { "kind": "template_string" }, { "kind": "identifier" }] }
      },
      "emit": {
        "kind": "endpoint",
        "receiver": "$R",
        "method": "$M",
        "path": "$P",
        "handler": "$$$H",
        "data": { "adapter": "express" }
      },
      "examples": {
        "match": [
          "router.post(\"/auth/sign-in\", guard, validate(schema), signIn);",
          "app.get(\"/health\", (req, res) => res.send(\"ok\"));"
        ],
        "noMatch": ["app.use(\"/health\", handler);", "map.has(\"k\");"]
      }
    },
    {
      "id": "mongoose-model",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "model($N, $$$A)" },
      "constraints": { "N": { "kind": "string" } },
      "emit": { "kind": "table", "name": "$N", "binding": true },
      "examples": {
        "match": ["export const User = model('User', schema);"],
        "noMatch": ["const x = models.get('User');"]
      }
    },
    {
      "id": "mongoose-static-read",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "$M.$METHOD($$$A)" },
      "constraints": { "M": { "kind": "identifier" } },
      "emit": { "kind": "read", "table": "$M", "method": "$METHOD" },
      "examples": {
        "match": ["User.findById(id).lean();"],
        "noMatch": ["a.b.findById(id);", "findById(id);"]
      }
    },
    {
      "id": "mongoose-static-write",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "$M.$METHOD($$$A)" },
      "constraints": { "M": { "kind": "identifier" } },
      "emit": { "kind": "write", "table": "$M", "method": "$METHOD" },
      "examples": {
        "match": ["User.create(data);"],
        "noMatch": ["a.b.create(data);", "create(data);"]
      }
    },
    {
      "id": "mongoose-collection-read",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "$M.collection.$METHOD($$$A)" },
      "constraints": { "M": { "kind": "identifier" } },
      "emit": { "kind": "read", "table": "$M", "method": "$METHOD" },
      "examples": {
        "match": ["Media.collection.countDocuments({});"],
        "noMatch": ["Media.docs.countDocuments({});", "a.b.collection.countDocuments({});"]
      }
    },
    {
      "id": "mongoose-collection-write",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "$M.collection.$METHOD($$$A)" },
      "constraints": { "M": { "kind": "identifier" } },
      "emit": { "kind": "write", "table": "$M", "method": "$METHOD" },
      "examples": {
        "match": ["Media.collection.updateMany({}, {});"],
        "noMatch": ["Media.docs.updateMany({}, {});", "a.b.collection.updateMany({}, {});"]
      }
    },
    {
      "id": "mongoose-new-save",
      "language": "typescript",
      "when": { "dependency": ["mongoose"] },
      "rule": { "pattern": "new $M($$$A).save($$$B)" },
      "emit": { "kind": "write", "table": "$M" },
      "examples": {
        "match": ["await new User({ email }).save({ session });"],
        "noMatch": ["user.save();"]
      }
    }
  ]
}
